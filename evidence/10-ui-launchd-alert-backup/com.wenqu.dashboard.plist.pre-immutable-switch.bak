<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.wenqu.dashboard</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/maccc/.wenqu/dashboard/server.py</string>
    <string>--port</string>
    <string>7789</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/maccc/.wenqu/logs/dashboard-modular.out.log</string>
  <key>StandardErrorPath</key><string>/Users/maccc/.wenqu/logs/dashboard-modular.err.log</string>
</dict>
</plist>
