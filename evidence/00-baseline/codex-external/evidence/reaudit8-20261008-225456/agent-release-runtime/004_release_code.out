   331	def _load_manifest(manifest_path: str) -> Dict[str, Any]:
   332	    try:
   333	        with open(manifest_path, "r", encoding="utf-8") as fh:
   334	            data = json.load(fh)
   335	    except (OSError, ValueError) as exc:  # 含 JSONDecodeError/UnicodeDecodeError
   336	        _die(f"manifest 不可读/非 JSON: {manifest_path!r} ({exc})")
   337	    if not isinstance(data, dict) or data.get("schema") != MANIFEST_SCHEMA:
   338	        _die(f"manifest schema 不符（期望 {MANIFEST_SCHEMA}）: {manifest_path!r}")
   339	    return data
