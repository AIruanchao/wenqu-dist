   342	def cmd_sign(args: argparse.Namespace) -> int:
   343	    manifest_path = os.path.abspath(args.manifest)
   344	    manifest = _load_manifest(manifest_path)
   345	
   346	    try:
   347	        ring = ApprovalKeyring.from_path(os.path.abspath(args.keyring))
   348	    except (OSError, ValueError, KeyError) as exc:
   349	        _die(f"keyring 加载失败: {exc}")
   350	
   351	    key_id = args.key_id
   352	    if key_id is None:
   353	        active = ring.active_key_ids()
   354	        if not active:
   355	            _die("keyring 无 active key（全部 rotated/revoked/expired）——拒绝签名")
   356	        key_id = active[0]
   357	    try:
   358	        secret = ring.get_for_signing(key_id)  # rotated/revoked/expired 全拒
   359	    except KeyError as exc:
   360	        _die(f"签名取 key 失败: {exc}")
   361	
   362	    # 被签信封 = manifest + key_id 绑定（与 verify 侧 ApprovalKeyring.verify
   363	    # 的 envelope 构造完全一致：verify 从信封读 key_id 查 key 后重算 HMAC——
   364	    # 签名同时钉住「用哪把 key 签的」）。
   365	    envelope = dict(manifest)
   366	    envelope["key_id"] = key_id
   367	    signature = sign_envelope(secret, envelope)  # canonical JSON HMAC-SHA256
   368	    # canonical JSON 规范与 approval_keys._canonical_json 同源（排序+紧凑+
   369	    # 非转义）——此处哈希仅为 sig 内信息性回显，验签权威仍是重算的 HMAC。
   370	    canonical = json.dumps(envelope, sort_keys=True, separators=(",", ":"),
   371	                           ensure_ascii=False)
   372	    sig = {
   373	        "schema": SIG_SCHEMA,
   374	        "algorithm": "HMAC-SHA256",
   375	        "key_id": key_id,
   376	        "signed_object": "manifest",
   377	        "signed_manifest_build_id": manifest.get("build_id"),
   378	        "signed_manifest_canonical_sha256": hashlib.sha256(
   379	            canonical.encode("utf-8")).hexdigest(),
   380	        "signature": signature,
   381	        "signed_at": _utc_now_iso(),
   382	        "tool": TOOL_NAME,
   383	        "tool_version": TOOL_VERSION,
   384	        "honesty": _SIG_HONESTY_NOTE,
   385	    }
   386	    out = args.out
   387	    if out is None:
   388	        stem = manifest_path[: -len(".manifest.json")] \
   389	            if manifest_path.endswith(".manifest.json") else manifest_path
   390	        out = stem + ".release.sig"
   391	    with open(out, "w", encoding="utf-8") as fh:
   392	        json.dump(sig, fh, ensure_ascii=False, indent=1, sort_keys=True)
   393	        fh.write("\n")
   394	    print(f"SIGN OK  key_id={key_id}  →  {out}")
   395	    print(f"  signature={signature}")
   396	    return 0
   397	
