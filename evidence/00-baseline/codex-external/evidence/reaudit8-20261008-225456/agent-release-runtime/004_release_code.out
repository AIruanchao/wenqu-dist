   570	# ---------------------------------------------------------------------- #
   571	# verify（tar ↔ manifest ↔ sig ↔ sbom 三方对账；任一不符 exit 1）
   572	# ---------------------------------------------------------------------- #
   573	def _load_json(path: str, what: str) -> Dict[str, Any]:
   574	    try:
   575	        with open(path, "r", encoding="utf-8") as fh:
   576	            data = json.load(fh)
   577	    except (OSError, ValueError) as exc:  # ValueError 含 JSONDecodeError 与
   578	        # UnicodeDecodeError——坏字节/坏编码同样按 verify 判 FAIL 收口，
   579	        # 不允许裸 traceback（对抗实测：翻字节致非 UTF-8 曾打出 crash 栈）。
   580	        raise VerifyFail(f"{what} 不可读/非 JSON: {path!r} ({exc})")
   581	    if not isinstance(data, dict):
   582	        raise VerifyFail(f"{what} 不是 JSON 对象: {path!r}")
   583	    return data
