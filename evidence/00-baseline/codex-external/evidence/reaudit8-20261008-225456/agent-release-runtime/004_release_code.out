   122	def _sha256_file(path: str) -> str:
   123	    h = hashlib.sha256()
   124	    with open(path, "rb") as fh:
   125	        for chunk in iter(lambda: fh.read(1 << 20), b""):
   126	            h.update(chunk)
   127	    return h.hexdigest()
