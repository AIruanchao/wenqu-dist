   147	def _safe_member_path(name: str) -> bool:
   148	    """tar 成员路径防御：拒绝绝对路径 / .. 逃逸 / 反斜杠混淆（fail-closed）。"""
   149	    if not name or name.startswith("/") or "\\" in name:
   150	        return False
   151	    parts = name.split("/")
   152	    return all(p not in ("", "..", ".") for p in parts) and name != "./"
