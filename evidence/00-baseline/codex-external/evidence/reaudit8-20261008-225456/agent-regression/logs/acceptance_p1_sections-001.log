   276	def build_catalog():
   277	    """构建 131 个 ID 的冻结目录并做完整性自检。"""
   278	    catalog = {}
   279	    for (prefix, num), (injection, expectation) in ID_DEFS.items():
   280	        test_id = f"{prefix}-{num:02d}"
   281	        req, ac, wps, ev_class = PREFIX_META[prefix]
   282	        catalog[test_id] = {
   283	            "prefix": prefix,
   284	            "section": SECTION_OF.get((prefix, num), "20.5"),
   285	            "injection": injection,
   286	            "expectation": expectation,
   287	            "req": req,
   288	            "ac": ac,
   289	            "work_packages": wps,
   290	            "evidence_class": ev_class,
   291	        }
   292	    problems = []
   293	    if len(catalog) != EXPECTED_TOTAL:
   294	        problems.append(f"目录数量 {len(catalog)} != {EXPECTED_TOTAL}")
   295	    # 前缀分母核对（§25.1 范围展开）
   296	    expected_counts = {
   297	        "GATE": 12, "AUTH": 6, "ACT": 6, "MRG": 7, "STATE": 11, "MIG": 5, "DB": 6,
   298	        "SC": 5, "ADV": 2, "TEN": 8, "PERF": 6, "SCH": 7, "ALT": 2, "BAK": 1,
   299	        "REL": 3, "STOP": 3, "RUN": 3, "CI": 5, "COND": 6, "RISK": 1, "STA": 2,
   300	        "DEP": 9, "RB": 1, "UI": 7, "HLT": 1, "DOC": 4, "CAP": 1, "DR": 1,
   301	    }
   302	    actual_counts = {}
   303	    for tid in catalog:
   304	        actual_counts[tid.split("-")[0]] = actual_counts.get(tid.split("-")[0], 0) + 1
   305	    if actual_counts != expected_counts:
   306	        for k in sorted(set(expected_counts) | set(actual_counts)):
   307	            if expected_counts.get(k) != actual_counts.get(k):
   308	                problems.append(
   309	                    f"前缀 {k}: 期望 {expected_counts.get(k)} 实际 {actual_counts.get(k)}")
   310	    # 编号连续性（CI 特例：05~09）
   311	    ranges = {"CI": (5, 9)}
   312	    for tid in catalog:
   313	        prefix, num = tid.split("-")[0], int(tid.split("-")[1])
   314	        lo, hi = ranges.get(prefix, (1, expected_counts[prefix]))
   315	        if not (lo <= num <= hi):
   316	            problems.append(f"ID {tid} 超出定义范围 {lo}~{hi}")
   317	    dup = EXPECTED_TOTAL - len(catalog)
   318	    if dup:
   319	        problems.append(f"疑似重复/缺失 {dup} 项")
   320	    return catalog, problems
