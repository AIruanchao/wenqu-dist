   323	def cross_check_plan(plan_path, catalog):
   324	    """可选：解析方案 §20 表格，与冻结目录做 ID 集合等式校验 + 逐 ID 语义比对。
   325	
   326	    F4-TRC-001 根修（Codex 第四轮实锤）：旧版只比 ID 集合——保留 ID 不动、
   327	    只改该行「注入/期望」文本的语义篡改全绿。现从 §20.1～§20.5 表格逐行解析
   328	    (ID, 注入, 期望)，与冻结目录（ID_DEFS 转录）做归一化语义比对：
   329	    去首尾空白、markdown 反引号剥离、全半角标点归一、连续空白折叠。
   330	    任一 ID 语义漂移 → semantic problems → --check exit 2。
   331	
   332	    F6-TRC-PARSER-002 根修（Codex 第六轮实锤）：表格行重复检出报 problem——
   333	    重复相同行（整表任何 ID 出现两行）与同 ID 异内容行（先毒后正/先正后毒，
   334	    旧版 dict 后行覆盖前行=投毒行可被正行掩蔽的 fail-open）一律 problem。
   335	    """
   336	    try:
   337	        with open(plan_path, encoding="utf-8") as f:
   338	            text = f.read()
   339	    except OSError as e:
   340	        return {"ok": False, "error": f"读取方案失败: {e}", "plan_ids": None}
   341	    body = text
   342	    # 只取 §20～§21 之间的正文，避免 §25 表格里的范围写法（GATE-01～12）污染集合
   343	    m20 = re.search(r"^# 20\.", body, re.M)
   344	    m21 = re.search(r"^# 21\.", body, re.M)
   345	    if m20 and m21:
   346	        body = body[m20.start():m21.start()]
   347	    ids = set(re.findall(r"\b([A-Z]{2,5}-\d{2})\b", body))
   348	    plan_ids = {i for i in ids if not re.match(r"^(FND|W\d)", i)}
   349	    frozen = set(catalog)
   350	    # ---- 逐 ID 语义比对（F4-TRC-001）------------------------------------
   351	    semantic_problems = []
   352	    row_re = re.compile(
   353	        r"^\|\s*([A-Z]{2,5}-\d{2})\s*\|\s*([^|]+?)\s*\|\s*([^|]+?)\s*\|\s*$")
   354	    plan_semantics = {}
   355	    duplicate_rows = []
   356	    for line in body.splitlines():
   357	        mm = row_re.match(line)
   358	        if not mm:
   359	            continue
   360	        tid = mm.group(1)
   361	        content = (mm.group(2), mm.group(3))
   362	        if tid in plan_semantics:
   363	            first = plan_semantics[tid]
   364	            if (_norm_semantic(first[0]) == _norm_semantic(content[0])
   365	                    and _norm_semantic(first[1]) == _norm_semantic(content[1])):
   366	                duplicate_rows.append(
   367	                    f"§20 表格 {tid} 存在重复相同行（重复行一律 problem）")
   368	            else:
   369	                duplicate_rows.append(
   370	                    f"§20 表格 {tid} 重复 ID 行且内容不一致"
   371	                    "（先毒后正/先正后毒——后行覆盖前行的 fail-open 已闭）")
   372	        plan_semantics[tid] = content
   373	    semantic_problems.extend(duplicate_rows)
   374	    if not plan_semantics:
   375	        semantic_problems.append("§20 表格解析出 0 行数据行（格式漂移？）")
   376	    for tid in sorted(frozen):
   377	        if tid not in plan_semantics:
   378	            # 集合等式已另行报告；这里防「ID 在正文他处出现但表格行被删」的缝隙
   379	            semantic_problems.append(f"§20 表格缺 {tid} 行（或行格式无法解析）")
   380	            continue
   381	        plan_inj, plan_exp = plan_semantics[tid]
   382	        frozen_inj = catalog[tid]["injection"]
   383	        frozen_exp = catalog[tid]["expectation"]
   384	        if _norm_semantic(plan_inj) != _norm_semantic(frozen_inj):
   385	            semantic_problems.append(
   386	                f"{tid} 注入语义漂移: 方案={plan_inj!r} 冻结={frozen_inj!r}")
   387	        if _norm_semantic(plan_exp) != _norm_semantic(frozen_exp):
   388	            semantic_problems.append(
   389	                f"{tid} 期望语义漂移: 方案={plan_exp!r} 冻结={frozen_exp!r}")
   390	    for tid in sorted(set(plan_semantics) - frozen):
   391	        semantic_problems.append(f"§20 表格行 {tid} 不在冻结目录中")
   392	    return {
   393	        "ok": plan_ids == frozen and not semantic_problems,
   394	        "plan_only": sorted(plan_ids - frozen),
   395	        "frozen_only": sorted(frozen - plan_ids),
   396	        "plan_ids_count": len(plan_ids),
   397	        "frozen_count": len(frozen),
   398	        "semantic_ok": not semantic_problems,
   399	        "semantic_problems": semantic_problems,
   400	        "semantic_rows_parsed": len(plan_semantics),
   401	        "duplicate_row_count": len(duplicate_rows),
   402	    }
   403	
   404	
   405	# 全角→半角标点归一表（语义比对用；只归一标点，不动字母/数字/汉字）
   406	_FW_PUNCT = {
   407	    "，": ",", "、": ",", "。": ".", "？": "?", "！": "!", "：": ":",
   408	    "；": ";", "（": "(", "）": ")", "～": "~", "「": '"', "」": '"',
   409	    "『": '"', "』": '"', "“": '"', "”": '"', "‘": "'", "’": "'",
   410	    "【": "[", "】": "]", "《": "<", "》": ">", "　": " ",
   411	}
   412	
   413	
   414	def _norm_semantic(s):
   415	    """§20 语义归一化：去 markdown 反引号、全半角标点归一、折叠空白、去首尾。"""
   416	    if not isinstance(s, str):
   417	        return "" if s is None else str(s)
   418	    out = s.replace("`", "")
   419	    out = "".join(_FW_PUNCT.get(ch, ch) for ch in out)
   420	    out = re.sub(r"\s+", " ", out)
