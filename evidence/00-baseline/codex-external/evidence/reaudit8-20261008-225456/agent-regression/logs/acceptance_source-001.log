    TF_RC=$?
    NF=$(grep -c "^def test_" "$ROOT/system/tests/$tf.py" || true)
    if [ $TF_RC -eq 0 ] && [ "${NF:-0}" -gt 0 ]; then
      P1F_COUNT=$((P1F_COUNT+NF))
    else
