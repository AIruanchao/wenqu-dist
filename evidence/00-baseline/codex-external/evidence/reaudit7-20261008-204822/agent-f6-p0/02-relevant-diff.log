+                return e.data
+            if ttl is not None and stamp is None and time.time() - e.ts < ttl:
+                return e.data
+        data = loader() if loader else None
+        if data is not None:
+            e.data = data
+            e.ts = time.time()
+            e.stamp = stamp
+        return data
