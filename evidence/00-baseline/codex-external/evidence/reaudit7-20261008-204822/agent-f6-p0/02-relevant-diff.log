+def write_key_to_dir(keyring_dir: str, key_id: str, secret: str,
+                     meta: Optional[Mapping[str, Any]] = None) -> Dict[str, Any]:
+    """把 secret（0600）+ 元数据边车 ``<key_id>.meta.json``（0600）写入目录。
