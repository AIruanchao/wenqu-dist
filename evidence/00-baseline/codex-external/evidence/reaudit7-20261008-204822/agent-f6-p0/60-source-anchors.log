   438	def migrate_legacy_events(sqlite_path: str,
   439	                          sidecar_path: Optional[str] = None) -> Dict[str, Any]:
   440	    """把旧版迁移器 ``events`` 表的历史残留行一次性收编进 pipeline_events。
   441	
   442	    契约：
   443	    - 只读旧表：本函数绝不 CREATE/INSERT/UPDATE/DELETE 旧 ``events`` 表
   444	      （保留只读兼容；收编后旧表原样留在库中，仅供对账，不再是正源）；
   445	    - 单一写入 API：每行经 ``EventStore.append`` 以
   446	      ``LEGACY_EVENTS_ROW_MIGRATED`` 事件入 ``pipeline_events`` 哈希链；
   447	      事件负载是旧行已记内容（line_sha/status/payload）的纯函数——重跑
   448	      全部计 duplicate，零重复入账（一次性、幂等）；
   449	    - 旧行按已入账历史记录原样收编（status 等字段原封不动）：旧表行是
   450	      旧制度下已落账的数据，收编时重新判定/归一会改写历史账目，故只做
   451	      搬运、绝不再判；JSONL 源行的 quarantine 语义在 :meth:`LedgerMigrator.migrate`；
   452	    - 守恒：rows_seen == imported + duplicates，否则 ConservationError；
   453	    - 逐行 sidecar 审计（append-only），携带旧表 id/source_file/source_line
   454	      位置溯源。
   455	
   456	    旧表不存在（新库/已收编库）不是错误：报告 ``legacy_table_present=False``。
   457	    """
   458	    sqlite_path = os.path.abspath(sqlite_path)
   459	    sidecar_path = (os.path.abspath(sidecar_path) if sidecar_path
   460	                    else sqlite_path + ".legacy-events-sidecar.jsonl")
   461	    os.makedirs(os.path.dirname(sidecar_path) or ".", exist_ok=True)
   462	
   463	    store = EventStore(sqlite_path)
   464	    try:
   465	        # 表名是模块常量（不可信输入不进 SQL 文本）；存在性用参数化查询
   466	        present = store._conn.execute(
   467	            "SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = ?",
   468	            (LEGACY_EVENTS_TABLE,),
   469	        ).fetchone() is not None
   470	
   471	        legacy_rows: List[Dict[str, Any]] = []
   472	        if present:
   473	            cols = {r[1] for r in store._conn.execute(
   474	                f"PRAGMA table_info({LEGACY_EVENTS_TABLE})")}
   475	            missing = _LEGACY_REQUIRED_COLUMNS - cols
   476	            if missing:
   477	                # 形状异常 fail-closed：同名表不是旧迁移器产物，绝不猜搬
   478	                raise RuntimeError(
   479	                    f"legacy table {LEGACY_EVENTS_TABLE!r} has unexpected shape; "
   480	                    f"missing columns: {sorted(missing)}; refusing to migrate")
   481	            # 只读 SELECT——旧表全程零写入
   482	            for rid, line_sha, status, source_file, source_line, payload in store._conn.execute(
   483	                f"SELECT id, line_sha, status, source_file, source_line, payload "
   484	                f"FROM {LEGACY_EVENTS_TABLE} ORDER BY id"
   485	            ):
   486	                legacy_rows.append({
   487	                    "id": rid, "line_sha": line_sha, "status": status,
   488	                    "source_file": source_file, "source_line": source_line,
   489	                    "payload": payload,
   490	                })
   491	
   492	        imported = duplicates = 0
   493	        with open(sidecar_path, "a", encoding="utf-8") as sidecar:
   494	            for row in legacy_rows:
   495	                event = {
   496	                    "event_type": LEGACY_RESIDUE_EVENT_TYPE,
   497	                    "line_sha": row["line_sha"],
   498	                    "status": row["status"],
   499	                    "raw": row["payload"],
   500	                }
   501	                _event_hash, inserted = store.append(event)
   502	                if inserted:
   503	                    imported += 1
   504	                    decision = "imported"
   505	                else:
   506	                    duplicates += 1
   507	                    decision = "duplicate"
   508	                sidecar.write(json.dumps({
   509	                    "decision": decision,
   510	                    "legacy_table": LEGACY_EVENTS_TABLE,
   511	                    "legacy_id": row["id"],
   512	                    "line_sha": row["line_sha"],
   513	                    "source_file": row["source_file"],
   514	                    "source_line": row["source_line"],
   515	                }, ensure_ascii=False, sort_keys=True) + "\n")
   516	
   517	        store.verify_chain()
   518	        if len(legacy_rows) != imported + duplicates:
   519	            raise ConservationError(
   520	                f"legacy residue conservation violated: rows_seen={len(legacy_rows)} != "
   521	                f"imported({imported}) + duplicates({duplicates})")
   522	
   523	        return {
   524	            "sqlite_path": sqlite_path,
   525	            "legacy_table": LEGACY_EVENTS_TABLE,
   526	            "legacy_table_present": present,
   527	            "rows_seen": len(legacy_rows),
   528	            "imported": imported,
   529	            "duplicates": duplicates,
   530	            "event_table": "pipeline_events",
   531	            "write_api": "EventStore.append",
   532	            "sidecar_path": sidecar_path,
   533	            "chain_verified": True,
   534	        }
   535	    finally:
   536	        store.close()
