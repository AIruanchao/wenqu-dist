   447	def ensure_keyring_dir(path: str) -> None:
   448	    """创建/收敛 keyring 目录为 owner-only（0700——目录需要 x 位）。"""
   449	    os.makedirs(path, mode=_KEYRING_DIR_MODE, exist_ok=True)
   450	    os.chmod(path, _KEYRING_DIR_MODE)
