   297	    # ------------------------------------------------------------------ #
   298	    @classmethod
   299	    def generate(cls, key_id: str, *, secret: Optional[str] = None,
   300	                 nbytes: int = 32) -> "ApprovalKeyring":
   301	        """生成单 key keyring（测试/初始化用；secret 省略则 crypto 随机）。"""
   302	        return cls({key_id: secret if secret is not None
   303	                    else generate_secret(nbytes)})
   304	
   305	    def save_json(self, path: str) -> None:
   306	        """把 keyring（含元数据）落盘为 JSON 文件（0600，供下次 from_path 加载）。"""
   307	        payload = json.dumps({"keys": dict(self._keys),
   308	                              "meta": dict(self._meta)},
   309	                             indent=2, ensure_ascii=False)
   310	        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
   311	        with os.fdopen(fd, "w", encoding="utf-8") as fh:
   312	            fh.write(payload + "\n")
