   314	    # ------------------------------------------------------------------ #
   315	    # P0-2 残余：生命周期元数据视图与签发资格
   316	    # ------------------------------------------------------------------ #
   317	    def meta(self, key_id: str) -> Dict[str, Any]:
   318	        """单 key 元数据副本（无元数据的 key 返回 {status: active}）。"""
   319	        if key_id not in self._keys:
   320	            raise KeyNotFoundError(
   321	                f"key_id {key_id!r} not registered in keyring "
   322	                f"(known: {sorted(self._keys)})") from None
   323	        return dict(self._meta.get(key_id, {"status": KEY_STATUS_ACTIVE}))
   324	
   325	    def _key_expired(self, key_id: str) -> bool:
   326	        expiry = self._meta.get(key_id, {}).get("expiry")
   327	        if expiry is None:
   328	            return False
   329	        epoch = _parse_iso_or_none(expiry, "expiry")
   330	        return epoch is not None and epoch <= time.time()
   440	    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC,
   441	                 _SECRET_FILE_MODE)
   442	    with os.fdopen(fd, "w", encoding="utf-8") as fh:
   443	        fh.write(data)
   444	    os.chmod(path, _SECRET_FILE_MODE)  # 掩盖既有宽权限文件
