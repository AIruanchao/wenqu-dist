   453	def write_key_to_dir(keyring_dir: str, key_id: str, secret: str,
   454	                     meta: Optional[Mapping[str, Any]] = None) -> Dict[str, Any]:
   455	    """把 secret（0600）+ 元数据边车 ``<key_id>.meta.json``（0600）写入目录。
   456	
   457	    返回规范化后的元数据。目录必须是受管 keyring 目录（0700）。
   458	    """
   459	    ApprovalKeyring._validate_key_id(key_id)  # noqa: SLF001 —— 复用命名约束
   460	    ensure_keyring_dir(keyring_dir)
   461	    _write_private_file(os.path.join(keyring_dir, f"{key_id}.secret"),
   462	                        secret + "\n")
   463	    normalized = ApprovalKeyring._normalize_meta(  # noqa: SLF001
   464	        key_id, dict(meta or {}))
   465	    normalized.setdefault("created_at", _utc_now_iso())
   466	    normalized = ApprovalKeyring._normalize_meta(key_id, normalized)
   467	    save_key_meta(keyring_dir, key_id, normalized)
   468	    return normalized
   469	
   470	
   471	def save_key_meta(keyring_dir: str, key_id: str,
   472	                  meta: Mapping[str, Any]) -> None:
   473	    """（覆盖）写单 key 元数据边车 ``<key_id>.meta.json``（0600）。"""
   474	    normalized = ApprovalKeyring._normalize_meta(key_id, dict(meta))  # noqa: SLF001
   475	    payload = json.dumps(normalized, indent=2, ensure_ascii=False,
   476	                         sort_keys=True)
   477	    _write_private_file(os.path.join(keyring_dir, f"{key_id}.meta.json"),
   478	                        payload + "\n")
   479	
   480	
   481	def append_keyring_event(event_log_path: str,
   482	                         record: Mapping[str, Any]) -> None:
   483	    """append-only 追加一条 keyring 生命周期事件（jsonl，0600，单次 write）。"""
   484	    line = json.dumps(dict(record), sort_keys=True, separators=(",", ":"),
   485	                      ensure_ascii=False)
   486	    fd = os.open(event_log_path,
   487	                 os.O_WRONLY | os.O_CREAT | os.O_APPEND, _SECRET_FILE_MODE)
   488	    try:
   489	        os.write(fd, (line + "\n").encode("utf-8"))
   490	    finally:
   491	        os.close(fd)
   492	    os.chmod(event_log_path, _SECRET_FILE_MODE)
