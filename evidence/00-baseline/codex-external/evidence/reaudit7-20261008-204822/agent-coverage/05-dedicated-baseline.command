set -o pipefail; total=0; for f in system/tests/test_ac_gate_family.py system/tests/test_ac_state_mig.py system/tests/test_ac_deploy_release.py system/tests/test_ac_station_families.py system/tests/test_ac_ops_families.py system/tests/test_ac_auth_cond.py system/tests/test_ac_act_run.py system/tests/test_ac_ui_family.py; do echo "=== $f ==="; python3 "$f"; rc=$?; echo "FILE_RC=$rc"; [ "$rc" -eq 0 ] || exit "$rc"; n=$(grep -c "^def test_" "$f"); total=$((total+n)); done; echo "DEDICATED_FUNCTIONS=$total"; [ "$total" -eq 131 ]
