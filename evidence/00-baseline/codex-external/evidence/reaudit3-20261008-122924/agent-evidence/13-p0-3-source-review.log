  1596	
  1597	def _self_test() -> int:
  1598	    """端到端冒烟：planner 升档 → 冻结 → 站0/站1 结果 → 双重校验。"""
  1599	    registry = default_registry()
  1600	    registry.validate()
  1601	    print(f"[1] registry {REGISTRY_VERSION} OK: 8 stations, "
  1602	          f"digest={registry.registry_digest()[:12]}…")
  1603	
  1604	    planner = BugscanPlanner(registry)
  1605	    plan = planner.plan("FAST", scope_flags=("touches_migration",))
  1606	    assert plan.lane_effective == "STANDARD" and plan.escalated
  1607	    assert plan.required_stations == (0, 1, 2, 3, 4)
  1608	    assert plan.convergence_rounds == 2
  1609	    print(f"[2] planner auto-escalation OK: FAST --touches_migration--> "
  1610	          f"STANDARD, required={plan.required_stations}, rounds={plan.convergence_rounds}")
  1611	
  1612	    sha = "1" * 40
  1613	    manifest = planner.freeze_run_manifest(
  1614	        plan,
  1615	        run_id="selftest-run-001",
  1616	        project_id="wenqu-selftest",
  1617	        commit_sha=sha,
  1618	        environment="local",
  1619	        scope=["src/**", "tests/**"],
  1620	        ruleset={"version": "w6a", "rules": ["W6A-ST0", "W6A-ST1"]},
  1621	        data_config={"profile": "default"},
  1622	    )
  1623	    st0 = manifest.to_station_result()
  1624	    validate_station_result(st0)
  1625	    print(f"[3] freeze OK: run={manifest.run_id} scope_hash={manifest.scope_hash[:12]}… "
  1626	          f"manifest_hash={manifest.manifest_hash[:12]}… ; station-0 result PASS "
  1627	          f"(coverage {st0['coverage']['scanned']}/{st0['coverage']['denominator']})")
  1628	
  1629	    gate = {
  1630	        "commit_sha": sha,
  1631	        "exit_code": 0,
  1632	        "tool": {"name": "ci-fast", "version": "1"},
  1633	        "started_at": manifest.frozen_at,
  1634	        "ended_at": manifest.frozen_at,
  1635	        "components": [
  1636	            {"name": "lint", "status": "COMPLETED", "exit_code": 0},
  1637	            {"name": "typecheck", "status": "COMPLETED", "exit_code": 0},
  1638	            {"name": "unit", "status": "COMPLETED", "exit_code": 0},
  1639	        ],
  1640	    }
  1641	    adapter = SourceGateAdapter(manifest, registry=registry)
  1642	    st1 = adapter.adapt(gate)
  1643	    validate_station_result(st1)
  1644	    print(f"[4] source-gate adapt OK: exit 0 → COMPLETED/PASS "
  1645	          f"(coverage {st1['coverage']['scanned']}/{st1['coverage']['denominator']})")
  1646	
  1647	    # 负例快检：跨 SHA 必拒 / 缩水必 BLOCKED / 降档必录五要素
  1648	    try:
  1649	        adapter.adapt({**gate, "commit_sha": "2" * 40})
  1650	        raise AssertionError("sha mismatch must raise")
  1651	    except SourceGateShaMismatch:
  1652	        pass
  1653	    st1_shrink = adapter.adapt({
  1654	        **gate,
  1655	        "components": [
  1656	            {"name": "lint", "status": "COMPLETED", "exit_code": 0},
  1657	            {"name": "unit", "status": "NOT_RUN"},
  1658	        ],
  1659	    })
  1660	    assert st1_shrink["execution_status"] == "BLOCKED"
  1661	    assert st1_shrink["policy_verdict"] != "PASS"
  1662	    try:
  1663	        planner.plan("STANDARD", downgrade_stations=(4,))
  1664	        raise AssertionError("downgrade without record must raise")
  1665	    except RiskDowngradeError:
  1666	        pass
  1667	    try:  # 到期超出 30 天日落窗口 → 拒绝
  1668	        planner.plan(
  1669	            "STANDARD",
  1670	            downgrade={"approver": "risk-owner", "reason": "行为面环境维护窗口暂停",
  1671	                       "scope": "station 4 only", "expiry": "2099-01-01T00:00:00Z"},
  1672	            downgrade_stations=(4,),
  1673	        )
  1674	        raise AssertionError("downgrade beyond 30d sunset must raise")
  1675	    except RiskDowngradeError:
  1676	        pass
  1677	    try:  # 站0 不可降档移除
  1678	        planner.plan(
  1679	            "STANDARD",
  1680	            downgrade={"approver": "risk-owner", "reason": "试图跳过范围冻结",
  1681	                       "scope": "station 0", "expiry": _iso_z(_utc_now() + timedelta(days=7))},
  1682	            downgrade_stations=(0,),
  1683	        )
  1684	        raise AssertionError("dropping station 0 must raise")
  1685	    except RiskDowngradeError:
  1686	        pass
  1687	    good = planner.plan(
  1688	        "STANDARD",
  1689	        downgrade={"approver": "risk-owner", "reason": "行为面环境维护窗口暂停",
  1690	                   "scope": "station 4 only", "expiry": _iso_z(_utc_now() + timedelta(days=7))},
  1691	        downgrade_stations=(4,),
  1692	    )
  1693	    assert good.required_stations == (0, 1, 2, 3)
  1694	    assert good.downgrade is not None and good.dropped_stations == (4,)
  1695	    print("[5] negative paths OK: cross-SHA refused / shrink→BLOCKED / "
  1696	          "downgrade requires valid 5-element record (30d sunset + floor {0,1} enforced)")
  1697	
  1698	    import tempfile as _tf
  1699	    with _tf.TemporaryDirectory() as tmp:
  1700	        path = Path(tmp) / "run-manifest.json"
  1701	        manifest.save(path)
  1702	        manifest.save(path)  # 幂等
  1703	        loaded = RunManifest.load(path)
  1704	        assert loaded.manifest_hash == manifest.manifest_hash
  1705	        print(f"[6] manifest save/load OK: {path.name} idempotent + hash verified")
  1706	    print("SELF-TEST PASS")
  1707	    return 0
  1708	
  1709	
  1710	if __name__ == "__main__":
  1711	    raise SystemExit(_self_test())
