   786	# ---------------------------------------------------------------------------
   787	# RunManifest——站0 冻结件
   788	# ---------------------------------------------------------------------------
   789	
   790	@dataclass(frozen=True)
   791	class RunManifest:
   792	    """冻结后的 run manifest（不可变值对象）。
   793	
   794	    - manifest_hash = sha256(canonical(内容 sans manifest_hash))。
   795	    - save() 幂等且防篡改：已存在文件与本次内容逐字节一致 → no-op；
   796	      不一致 → ManifestFreezeError（冻结后不可变）。
   797	    - to_station_result() 产出站0 的 station-result-v2 结果。
   798	    """
   799	
   800	    run_id: str
   801	    created_at: str
   802	    frozen_at: str
   803	    registry_version: str
   804	    registry_digest: str
   805	    plan: BugscanPlan
   806	    project_id: str
   807	    commit_sha: str
   808	    base_sha: Optional[str]
   809	    environment: str
   810	    scope_hash: str
   811	    ruleset_hash: str
   812	    data_config_hash: str
   813	    lockfile_hash: Optional[str]
   814	    scope_paths: Tuple[str, ...]
   815	    scope_exclusions: Tuple[str, ...]
   816	    required_stations: Tuple[int, ...]
   817	    station_ttls: Dict[int, int]
   818	    manifest_hash: str
   819	
   820	    # -- 序列化 -------------------------------------------------------------
   821	    def to_dict(self) -> Dict[str, Any]:
   822	        out: Dict[str, Any] = {
   823	            "schema_version": SCHEMA_VERSION,
   824	            "manifest_kind": "bugscan/run-manifest",
   825	            "registry_version": self.registry_version,
   826	            "registry_digest": self.registry_digest,
   827	            "run_id": self.run_id,
   828	            "created_at": self.created_at,
   829	            "frozen_at": self.frozen_at,
   830	            "planner": self.plan.to_dict(),
   831	            "identity": {
   832	                "project_id": self.project_id,
   833	                "commit_sha": self.commit_sha,
   834	                "environment": self.environment,
   835	                "scope_hash": self.scope_hash,
   836	                "ruleset_hash": self.ruleset_hash,
   837	                "data_config_hash": self.data_config_hash,
   838	            },
   839	            "scope": {
   840	                "paths": list(self.scope_paths),
   841	                "exclusions": list(self.scope_exclusions),
   842	                "denominator": len(self.scope_paths),
   843	            },
   844	            "required_stations": list(self.required_stations),
   845	            "station_ttls": {str(k): v for k, v in sorted(self.station_ttls.items())},
   846	            "manifest_hash": self.manifest_hash,
   847	        }
   848	        if self.base_sha is not None:
   849	            out["identity"]["base_sha"] = self.base_sha
   850	        if self.lockfile_hash is not None:
   851	            out["identity"]["lockfile_hash"] = self.lockfile_hash
   852	        return out
   853	
   854	    def to_json(self) -> str:
   855	        return _canonical_json(self.to_dict())
   856	
   857	    @property
   858	    def denominator(self) -> int:
   859	        return len(self.scope_paths)
   860	
   861	    def artifact_cas_digest(self) -> Tuple[str, int]:
   862	        """manifest 自身作为站0 工件：CAS digest + 字节数。"""
   863	        payload = self.to_json().encode("utf-8")
   864	        return f"sha256:{_sha256_hex(payload)}", len(payload)
   865	
   866	    # -- 落盘 ---------------------------------------------------------------
   867	    def save(self, path: str | os.PathLike[str]) -> Path:
   868	        """原子写 run-manifest.json；冻结语义=同内容幂等、异内容拒绝。"""
   869	        target = Path(path)
   870	        payload = self.to_json().encode("utf-8")
   871	        if target.exists():
   872	            existing = target.read_bytes()
   873	            if existing == payload:
   874	                return target  # 幂等：同一冻结件重复保存
   875	            raise ManifestFreezeError(
   876	                f"{target} already holds a DIFFERENT frozen manifest "
   877	                f"({len(existing)}B vs {len(payload)}B)——冻结后不可变；"
   878	                "如需变更请新建 run（指纹变化即失效重跑）"
   879	            )
   880	        target.parent.mkdir(parents=True, exist_ok=True)
   881	        fd, tmp_name = tempfile.mkstemp(
   882	            dir=str(target.parent), prefix=".run-manifest-", suffix=".tmp"
   883	        )
   884	        try:
   885	            with os.fdopen(fd, "wb") as fh:
   886	                fh.write(payload)
   887	                fh.flush()
   888	                os.fsync(fh.fileno())
   889	            os.replace(tmp_name, target)
   890	        except BaseException:
   891	            try:
   892	                os.unlink(tmp_name)
   893	            except OSError:
   894	                pass
   895	            raise
   896	        return target
   897	
   898	    @classmethod
   899	    def load(cls, path: str | os.PathLike[str]) -> "RunManifest":
   900	        """读回并校验 manifest_hash（防篡改）。"""
   901	        raw = Path(path).read_bytes()
   902	        data = json.loads(raw.decode("utf-8"))
   903	        if not isinstance(data, Mapping):
   904	            raise ManifestFreezeError(f"{path}: manifest must be a JSON object")
   905	        stored_hash = data.get("manifest_hash")
   906	        body = {k: v for k, v in data.items() if k != "manifest_hash"}
   907	        recomputed = _hash_obj(body)
   908	        if stored_hash != recomputed:
   909	            raise ManifestFreezeError(
   910	                f"{path}: manifest_hash mismatch (stored {stored_hash!r} != "
   911	                f"recomputed {recomputed!r})——冻结件被篡改或损坏"
   912	            )
   913	        return cls._from_verified_dict(data)
   914	
   915	    @classmethod
   916	    def _from_verified_dict(cls, data: Mapping[str, Any]) -> "RunManifest":
   917	        plan_data = data["planner"]
   918	        downgrade = (
   919	            RiskAcceptance.from_mapping(plan_data["downgrade"])
   920	            if plan_data.get("downgrade") else None
   921	        )
   922	        identity = data["identity"]
   923	        plan = BugscanPlan(
   924	            lane_requested=plan_data["lane_requested"],
   925	            lane_effective=plan_data["lane_effective"],
   926	            required_stations=tuple(plan_data["required_stations"]),
   927	            convergence_rounds=int(plan_data["convergence_rounds"]),
   928	            escalated=bool(plan_data["escalated"]),
   929	            escalation_reasons=tuple(plan_data.get("escalation_reasons", ())),
   930	            downgrade=downgrade,
   931	            dropped_stations=tuple(plan_data.get("dropped_stations", ())),
   932	            registry_version=data["registry_version"],
   933	        )
   934	        return cls(
   935	            run_id=data["run_id"],
   936	            created_at=data["created_at"],
   937	            frozen_at=data["frozen_at"],
   938	            registry_version=data["registry_version"],
   939	            registry_digest=data["registry_digest"],
   940	            plan=plan,
   941	            project_id=identity["project_id"],
   942	            commit_sha=identity["commit_sha"],
   943	            base_sha=identity.get("base_sha"),
   944	            environment=identity["environment"],
   945	            scope_hash=identity["scope_hash"],
   946	            ruleset_hash=identity["ruleset_hash"],
   947	            data_config_hash=identity["data_config_hash"],
   948	            lockfile_hash=identity.get("lockfile_hash"),
   949	            scope_paths=tuple(data["scope"]["paths"]),
   950	            scope_exclusions=tuple(data["scope"].get("exclusions", ())),
   951	            required_stations=tuple(data["required_stations"]),
   952	            station_ttls={int(k): int(v) for k, v in data["station_ttls"].items()},
   953	            manifest_hash=data["manifest_hash"],
   954	        )
   955	
   956	    # -- 站0 station-result --------------------------------------------------
   957	    def to_station_result(
   958	        self,
   959	        *,
   960	        attempt_id: Optional[str] = None,
   961	        timeout_s: int = 60,
   962	    ) -> Dict[str, Any]:
   963	        """把冻结成功映射为站0 的 station-result-v2 结果。
   964	
   965	        执行语义：freeze_run_manifest 在本进程内完成；任何冻结失败都以
   966	        异常上抛、绝不产出结果——因此能够走到这里的那次"执行"必然成功
   967	        （actual_exit_code=0 只在成功路径可达，等价 trusted runner 语义）。
   968	        """
   969	        cas, size = self.artifact_cas_digest()
   970	        attempt = attempt_id or _make_attempt_id(self.run_id, "st0")
   971	        argv = ["wenqu_core.bugscan_orchestrator", "freeze_run_manifest", self.run_id]
   972	        result = build_station_result(
   973	            run_id=self.run_id,
   974	            station_id=0,
   975	            attempt_id=attempt,
   976	            execution_status="COMPLETED",
   977	            policy_verdict="PASS",
   978	            identity={
   979	                "project_id": self.project_id,
   980	                "commit_sha": self.commit_sha,
   981	                "environment": self.environment,
   982	                "scope_hash": self.scope_hash,
   983	                "ruleset_hash": self.ruleset_hash,
   984	                "data_config_hash": self.data_config_hash,
   985	                **({"lockfile_hash": self.lockfile_hash} if self.lockfile_hash else {}),
   986	            },
   987	            tool={
   988	                "name": "wenqu_core.bugscan_orchestrator",
   989	                "version": __version__,
   990	                "digest": self.manifest_hash,
   991	            },
   992	            execution={
   993	                "argv_digest": _argv_digest(argv),
   994	                "started_at": self.created_at,
   995	                "ended_at": self.frozen_at,
   996	                "timeout_s": timeout_s,
   997	                "actual_exit_code": 0,
   998	                "expected_exit_set": [0],
   999	                "assertion_verdict": "PASS",
  1000	            },
  1001	            coverage={
  1002	                "denominator": self.denominator,
  1003	                "scanned": self.denominator,
  1004	                "exclusions": list(self.scope_exclusions),
  1005	            },
  1006	            finding_ids=[],
  1007	            artifacts=[{"cas_digest": cas, "size": size}],
  1008	        )
  1009	        return result
  1010	
  1011	
  1012	def _make_attempt_id(run_id: str, tag: str) -> str:
  1013	    seed = _hash_obj({"run_id": run_id, "tag": tag, "ts": _iso_z(_utc_now())})
  1014	    return f"att-{tag}-{seed[:12]}"
  1015	
  1016	
  1017	def _argv_digest(argv: Sequence[str]) -> str:
  1018	    """与 runner.TrustedRunner.argv_digest 同算法（canonical JSON of argv list）。"""
  1019	    canonical = json.dumps(list(argv), separators=(",", ":"), ensure_ascii=False)
  1020	    return _sha256_hex(canonical.encode("utf-8"))
  1021	
  1022	
  1023	# ---------------------------------------------------------------------------
  1024	# freeze_run_manifest——模块级入口（Codex W6A §15.2 站0）
  1025	# ---------------------------------------------------------------------------
  1026	
  1027	def freeze_run_manifest(
  1028	    plan: BugscanPlan,
  1029	    *,
  1030	    run_id: str,
  1031	    project_id: str,
  1032	    commit_sha: str,
  1033	    environment: str,
  1034	    scope: Iterable[str] | Mapping[str, Any],
  1035	    ruleset: Mapping[str, Any] | str,
  1036	    data_config: Mapping[str, Any] | str,
  1037	    base_sha: Optional[str] = None,
  1038	    lockfile_hash: Optional[str] = None,
  1039	    now: Optional[datetime] = None,
  1040	    registry: Optional[StationRegistry] = None,
  1041	) -> RunManifest:
  1042	    """冻结 run-manifest.json 的内容（返回 RunManifest，由调用方 .save() 落盘）。
  1043	
  1044	    绑定（不变量 #2/#3）：run_id + commit_sha + environment + scope_hash +
  1045	    ruleset_hash + data_config_hash + required 站集合 + 各站 TTL。
  1046	    run 起跑后任一指纹变化 → 旧证据立即失效，须重新冻结（新 run）。
  1047	    """
  1048	    registry = registry or default_registry()
  1049	    if not isinstance(plan, BugscanPlan):
  1050	        raise ManifestFreezeError(f"plan must be BugscanPlan, got {type(plan).__name__}")
  1051	    if not isinstance(run_id, str) or not _RE_RUN_ID.match(run_id):
  1052	        raise ManifestFreezeError(
  1053	            f"run_id must match {_RE_RUN_ID.pattern}, got {run_id!r}"
  1054	        )
  1055	    if not isinstance(project_id, str) or not project_id.strip():
  1056	        raise ManifestFreezeError("project_id must be a non-empty string")
  1057	    try:
  1058	        _require_sha40(commit_sha, what="commit_sha")
  1059	        if base_sha is not None:
  1060	            _require_sha40(base_sha, what="base_sha")
  1061	    except ValueError as exc:
  1062	        if isinstance(exc, ManifestFreezeError):
  1063	            raise
  1064	        raise ManifestFreezeError(str(exc)) from exc
  1065	    if environment not in ENVIRONMENTS:
  1066	        raise ManifestFreezeError(
  1067	            f"environment must be one of {ENVIRONMENTS}, got {environment!r}"
  1068	        )
  1069	
  1070	    # scope：list → paths（无排除）；mapping → {"paths":…, "exclusions":…}
  1071	    if isinstance(scope, Mapping):
  1072	        paths_raw = scope.get("paths", ())
  1073	        exclusions_raw = scope.get("exclusions", ())
  1074	    else:
  1075	        paths_raw, exclusions_raw = scope, ()
  1076	    if not isinstance(paths_raw, (list, tuple)):
  1077	        raise ManifestFreezeError("scope.paths must be a list/tuple of strings")
  1078	    if not isinstance(exclusions_raw, (list, tuple)):
  1079	        raise ManifestFreezeError("scope.exclusions must be a list/tuple of strings")
  1080	    paths = tuple(sorted({str(p) for p in paths_raw if str(p).strip()}))
  1081	    exclusions = tuple(sorted({str(e) for e in exclusions_raw if str(e).strip()}))
  1082	    if not paths:
  1083	        raise ManifestFreezeError(
  1084	            "scope must contain at least one path (范围分母齐全——空 scope 冻结非法)"
  1085	        )
  1086	    scope_hash = _hash_obj({"paths": list(paths), "exclusions": list(exclusions)})
  1087	
  1088	    try:
  1089	        ruleset_hash = _hash_or_digest(ruleset, what="ruleset")
  1090	        data_config_hash = _hash_or_digest(data_config, what="data_config")
  1091	        lockfile_digest = _hash_or_digest(lockfile_hash, what="lockfile_hash", required=False)
  1092	    except ValueError as exc:
  1093	        raise ManifestFreezeError(str(exc)) from exc
  1094	
  1095	    # required 站与计划一致 + TTL 全部落账
  1096	    required = tuple(sorted(set(plan.required_stations)))
  1097	    for station_id in required:
  1098	        registry.get(station_id)  # 未注册站 → KeyError（fail-closed）
  1099	    station_ttls = {i: registry.ttl_for(i) for i in required}
  1100	
  1101	    started = now or _utc_now()
  1102	    created_at = _iso_z(started)
  1103	    frozen_at = _iso_z(_utc_now())
  1104	    if _parse_iso(frozen_at, what="frozen_at") < _parse_iso(created_at, what="created_at"):
  1105	        frozen_at = created_at  # 时钟回拨保护：结束不得早于开始
  1106	
  1107	    body: Dict[str, Any] = {
  1108	        "schema_version": SCHEMA_VERSION,
  1109	        "manifest_kind": "bugscan/run-manifest",
  1110	        "registry_version": REGISTRY_VERSION,
  1111	        "registry_digest": registry.registry_digest(),
  1112	        "run_id": run_id,
  1113	        "created_at": created_at,
  1114	        "frozen_at": frozen_at,
  1115	        "planner": plan.to_dict(),
  1116	        "identity": {
  1117	            "project_id": project_id,
  1118	            "commit_sha": commit_sha,
  1119	            "environment": environment,
  1120	            "scope_hash": scope_hash,
  1121	            "ruleset_hash": ruleset_hash,
  1122	            "data_config_hash": data_config_hash,
  1123	        },
  1124	        "scope": {
  1125	            "paths": list(paths),
  1126	            "exclusions": list(exclusions),
  1127	            "denominator": len(paths),
  1128	        },
  1129	        "required_stations": list(required),
  1130	        "station_ttls": {str(k): v for k, v in sorted(station_ttls.items())},
  1131	    }
  1132	    if base_sha is not None:
  1133	        body["identity"]["base_sha"] = base_sha
  1134	    if lockfile_digest is not None:
  1135	        body["identity"]["lockfile_hash"] = lockfile_digest
  1136	    manifest_hash = _hash_obj(body)
  1137	    return RunManifest(
  1138	        run_id=run_id,
  1139	        created_at=created_at,
  1140	        frozen_at=frozen_at,
  1141	        registry_version=REGISTRY_VERSION,
  1142	        registry_digest=registry.registry_digest(),
  1143	        plan=plan,
  1144	        project_id=project_id,
  1145	        commit_sha=commit_sha,
  1146	        base_sha=base_sha,
  1147	        environment=environment,
  1148	        scope_hash=scope_hash,
  1149	        ruleset_hash=ruleset_hash,
  1150	        data_config_hash=data_config_hash,
  1151	        lockfile_hash=lockfile_digest,
  1152	        scope_paths=paths,
  1153	        scope_exclusions=exclusions,
  1154	        required_stations=required,
  1155	        station_ttls=station_ttls,
  1156	        manifest_hash=manifest_hash,
  1157	    )
  1158	
  1159	
  1160	# ---------------------------------------------------------------------------
  1161	# station-result-v2 构造与校验
  1162	# ---------------------------------------------------------------------------
  1163	
  1164	def build_station_result(
  1165	    *,
  1166	    run_id: str,
  1167	    station_id: int,
  1168	    attempt_id: str,
  1169	    execution_status: str,
  1170	    policy_verdict: str,
  1171	    identity: Mapping[str, Any],
  1172	    tool: Mapping[str, Any],
  1173	    execution: Mapping[str, Any],
  1174	    coverage: Mapping[str, Any],
  1175	    finding_ids: Iterable[str] = (),
  1176	    artifacts: Iterable[Mapping[str, Any]] = (),
  1177	) -> Dict[str, Any]:
  1178	    """按 schema 白名单构造 station-result-v2，并强制安全不变量：
  1179	
  1180	    1. 分母缩水守卫：scanned < denominator → 强制 BLOCKED/NOT_EVALUATED
  1181	       （铁律 2 与 schema $comment——该站绝不能记 PASS）。
  1182	    2. 执行非完成态（ERROR/BLOCKED/TIMEOUT/CANCELLED）→ 禁止 PASS。
  1183	    3. policy PASS 必须有 assertion_verdict=PASS 支撑。
  1184	    """
  1185	    if coverage.get("scanned", 0) < coverage.get("denominator", 0):
  1186	        execution_status = "BLOCKED"
  1187	        policy_verdict = "NOT_EVALUATED"
  1188	    if execution_status in ("ERROR", "BLOCKED", "TIMEOUT", "CANCELLED"):
  1189	        if policy_verdict == "PASS":
  1190	            raise StationResultValidationError(
  1191	                f"station {station_id}: execution_status={execution_status} "
  1192	                "forbids policy_verdict=PASS（铁律2：站内任一件 BLOCKED/ERROR"
  1193	                "→整站不得记 PASS）"
  1194	            )
  1195	    if policy_verdict == "PASS" and execution.get("assertion_verdict") != "PASS":
  1196	        raise StationResultValidationError(
  1197	            f"station {station_id}: policy PASS requires assertion_verdict=PASS"
  1198	        )
  1199	
  1200	    result: Dict[str, Any] = {
  1201	        "schema_version": SCHEMA_VERSION,
  1202	        "run_id": run_id,
  1203	        "station_id": station_id,
  1204	        "attempt_id": attempt_id,
  1205	        "execution_status": execution_status,
  1206	        "policy_verdict": policy_verdict,
  1207	        "identity": dict(identity),
  1208	        "tool": dict(tool),
  1209	        "execution": dict(execution),
  1210	        "coverage": {
  1211	            "denominator": coverage.get("denominator", 0),
  1212	            "scanned": coverage.get("scanned", 0),
  1213	            **({"exclusions": list(coverage["exclusions"])}
  1214	               if coverage.get("exclusions") else {}),
  1215	        },
  1216	        "finding_ids": list(finding_ids),
  1217	    }
  1218	    artifacts_list = [dict(a) for a in artifacts]
  1219	    if artifacts_list:
  1220	        result["artifacts"] = artifacts_list
  1221	    validate_station_result(result)
  1222	    return result
  1223	
  1224	
  1225	def validate_station_result(result: Any) -> None:
  1226	    """结构校验（schema 的可执行等价物）+ 不变量复核；失败聚合抛出。
  1227	
  1228	    可用时额外用 jsonschema 对 schemas/station-result-v2.schema.json
  1229	    做全量复核（双保险）；jsonschema 不可用时以本内置校验器为准。
  1230	    """
  1231	    issues: List[str] = []
  1232	
  1233	    def _check(condition: bool, message: str) -> None:
  1234	        if not condition:
  1235	            issues.append(message)
  1236	
  1237	    if not isinstance(result, Mapping):
  1238	        raise StationResultValidationError(
  1239	            f"station result must be a mapping, got {type(result).__name__}"
  1240	        )
  1241	    extra = set(result) - set(_STATION_RESULT_TOP_KEYS)
  1242	    _check(not extra, f"additional properties not allowed: {sorted(extra)}")
  1243	    for key in ("schema_version", "run_id", "station_id", "attempt_id",
  1244	                "execution_status", "policy_verdict", "identity", "tool",
  1245	                "execution"):
  1246	        _check(key in result, f"missing required property: {key}")
  1247	
  1248	    _check(result.get("schema_version") == SCHEMA_VERSION,
  1249	           f"schema_version must be {SCHEMA_VERSION!r}")
  1250	    _check(isinstance(result.get("run_id"), str) and bool(_RE_RUN_ID.match(result.get("run_id", ""))),
  1251	           f"run_id must match {_RE_RUN_ID.pattern}")
  1252	    sid = result.get("station_id")
  1253	    _check(isinstance(sid, int) and not isinstance(sid, bool) and 0 <= sid <= 7,
  1254	           f"station_id must be int in [0,7], got {sid!r}")
  1255	    _check(isinstance(result.get("attempt_id"), str) and result.get("attempt_id") != "",
  1256	           "attempt_id must be a non-empty string")
  1257	    _check(result.get("execution_status") in
  1258	           ("COMPLETED", "ERROR", "BLOCKED", "TIMEOUT", "CANCELLED"),
  1259	           f"invalid execution_status: {result.get('execution_status')!r}")
  1260	    _check(result.get("policy_verdict") in
  1261	           ("PASS", "FAIL", "CONDITIONAL", "NOT_APPLICABLE", "NOT_EVALUATED"),
  1262	           f"invalid policy_verdict: {result.get('policy_verdict')!r}")
  1263	
  1264	    identity = result.get("identity")
  1265	    if isinstance(identity, Mapping):
  1266	        extra_i = set(identity) - set(_IDENTITY_KEYS)
  1267	        _check(not extra_i, f"identity additional properties: {sorted(extra_i)}")
  1268	        _check(isinstance(identity.get("commit_sha"), str)
  1269	               and bool(_RE_SHA40.match(identity.get("commit_sha", ""))),
  1270	               "identity.commit_sha must be 40-char lowercase hex")
  1271	        _check(isinstance(identity.get("environment"), str)
  1272	               and identity.get("environment") != "",
  1273	               "identity.environment must be a non-empty string")
  1274	        _check(isinstance(identity.get("scope_hash"), str)
  1275	               and identity.get("scope_hash") != "",
  1276	               "identity.scope_hash must be a non-empty string")
  1277	        for opt in ("project_id", "ruleset_hash", "data_config_hash", "lockfile_hash"):
  1278	            if opt in identity:
  1279	                _check(isinstance(identity[opt], str), f"identity.{opt} must be a string")
  1280	    else:
  1281	        issues.append("identity must be an object")
  1282	
  1283	    tool = result.get("tool")
  1284	    if isinstance(tool, Mapping):
  1285	        _check(isinstance(tool.get("name"), str) and tool.get("name") != "",
  1286	               "tool.name must be a non-empty string")
  1287	        _check(isinstance(tool.get("version"), str) and tool.get("version") != "",
  1288	               "tool.version must be a non-empty string")
  1289	        if "digest" in tool:
  1290	            _check(isinstance(tool["digest"], str), "tool.digest must be a string")
  1291	    else:
  1292	        issues.append("tool must be an object")
  1293	
  1294	    execution = result.get("execution")
  1295	    if isinstance(execution, Mapping):
  1296	        extra_e = set(execution) - set(_EXECUTION_KEYS)
  1297	        _check(not extra_e, f"execution additional properties: {sorted(extra_e)}")
  1298	        for key in ("argv_digest", "started_at", "ended_at", "actual_exit_code",
  1299	                    "expected_exit_set", "assertion_verdict"):
  1300	            _check(key in execution, f"execution missing required property: {key}")
  1301	        _check(isinstance(execution.get("argv_digest"), str)
  1302	               and execution.get("argv_digest") != "",
  1303	               "execution.argv_digest must be a non-empty string")
  1304	        for ts_key in ("started_at", "ended_at"):
  1305	            value = execution.get(ts_key)
  1306	            ok = isinstance(value, str)
  1307	            if ok:
  1308	                try:
  1309	                    _parse_iso(value, what=f"execution.{ts_key}")
  1310	                except ValueError:
  1311	                    ok = False
  1312	            _check(ok, f"execution.{ts_key} must be an ISO-8601 date-time")
  1313	        exit_code = execution.get("actual_exit_code")
  1314	        _check(isinstance(exit_code, int) and not isinstance(exit_code, bool),
  1315	               f"execution.actual_exit_code must be an int, got {exit_code!r}")
  1316	        expected = execution.get("expected_exit_set")
  1317	        _check(isinstance(expected, list)
  1318	               and all(isinstance(x, int) and not isinstance(x, bool) for x in expected),
  1319	               "execution.expected_exit_set must be a list of ints")
  1320	        _check(execution.get("assertion_verdict") in ("PASS", "FAIL", "ERROR"),
  1321	               f"invalid execution.assertion_verdict: {execution.get('assertion_verdict')!r}")
  1322	        if "timeout_s" in execution:
  1323	            _check(isinstance(execution["timeout_s"], int)
  1324	                   and not isinstance(execution["timeout_s"], bool)
  1325	                   and execution["timeout_s"] >= 1,
  1326	                   "execution.timeout_s must be an int >= 1")
  1327	        if "cwd_digest" in execution:
  1328	            _check(isinstance(execution["cwd_digest"], str),
  1329	                   "execution.cwd_digest must be a string")
  1330	    else:
  1331	        issues.append("execution must be an object")
  1332	
  1333	    coverage = result.get("coverage")
  1334	    if coverage is not None:
  1335	        if isinstance(coverage, Mapping):
  1336	            extra_c = set(coverage) - set(_COVERAGE_KEYS)
  1337	            _check(not extra_c, f"coverage additional properties: {sorted(extra_c)}")
  1338	            for key in ("denominator", "scanned"):
  1339	                if key in coverage:
  1340	                    value = coverage[key]
  1341	                    _check(isinstance(value, int) and not isinstance(value, bool)
  1342	                           and value >= 0,
  1343	                           f"coverage.{key} must be an int >= 0")
  1344	            if "exclusions" in coverage:
  1345	                _check(isinstance(coverage["exclusions"], list)
  1346	                       and all(isinstance(x, str) for x in coverage["exclusions"]),
  1347	                       "coverage.exclusions must be a list of strings")
  1348	        else:
  1349	            issues.append("coverage must be an object")
  1350	
  1351	    findings = result.get("finding_ids", [])
  1352	    _check(isinstance(findings, list)
  1353	           and all(isinstance(x, str) and _RE_FND.match(x) for x in findings),
  1354	           "finding_ids must be a list of strings matching ^fnd_[a-zA-Z0-9_]+$")
  1355	
  1356	    artifacts = result.get("artifacts", [])
  1357	    if isinstance(artifacts, list):
  1358	        for idx, art in enumerate(artifacts):
  1359	            if isinstance(art, Mapping):
  1360	                _check(isinstance(art.get("cas_digest"), str)
  1361	                       and bool(_RE_CAS_DIGEST.match(art.get("cas_digest", ""))),
  1362	                       f"artifacts[{idx}].cas_digest must match sha256:<64hex>")
  1363	                size = art.get("size")
  1364	                _check(isinstance(size, int) and not isinstance(size, bool) and size >= 1,
  1365	                       f"artifacts[{idx}].size must be an int >= 1")
  1366	                extra_a = set(art) - {"cas_digest", "size"}
  1367	                _check(not extra_a,
  1368	                       f"artifacts[{idx}] additional properties: {sorted(extra_a)}")
  1369	            else:
  1370	                issues.append(f"artifacts[{idx}] must be an object")
  1371	    else:
  1372	        issues.append("artifacts must be a list")
  1373	
  1374	    # -- 不变量复核（schema $comment + 铁律 2）-------------------------------
  1375	    if isinstance(coverage, Mapping) and isinstance(execution, Mapping):
  1376	        denom = coverage.get("denominator", 0)
  1377	        scanned = coverage.get("scanned", 0)
  1378	        if isinstance(denom, int) and isinstance(scanned, int) and scanned < denom:
  1379	            _check(result.get("execution_status") == "BLOCKED",
  1380	                   "coverage shrink (scanned<denominator) requires execution_status=BLOCKED")
  1381	            _check(result.get("policy_verdict") != "PASS",
  1382	                   "coverage shrink (scanned<denominator) forbids policy_verdict=PASS")
  1383	        if result.get("execution_status") in ("ERROR", "BLOCKED", "TIMEOUT", "CANCELLED"):
  1384	            _check(result.get("policy_verdict") != "PASS",
  1385	                   "non-COMPLETED execution_status forbids policy_verdict=PASS")
  1386	
  1387	    if issues:
  1388	        raise StationResultValidationError(
  1389	            "station-result-v2 validation failed: " + "; ".join(issues)
  1390	        )
  1391	
  1392	    # -- 双保险：jsonschema 可用时对真实 schema 全量复核 ----------------------
  1393	    _cross_check_with_jsonschema(result)
  1394	
  1395	
  1396	def _cross_check_with_jsonschema(result: Mapping[str, Any]) -> None:
  1397	    schema_path = (
  1398	        Path(__file__).resolve().parent.parent / "schemas" / "station-result-v2.schema.json"
  1399	    )
  1400	    try:
  1401	        import jsonschema  # type: ignore
  1402	    except ImportError:
  1403	        return  # 第三方不可用：内置校验器即正源
  1404	    try:
  1405	        schema = json.loads(schema_path.read_text(encoding="utf-8"))
  1406	        jsonschema.validate(result, schema)
  1407	    except FileNotFoundError:
  1408	        return  # schema 文件不存在（嵌入部署等）——内置校验器兜底
  1409	    except Exception as exc:  # noqa: BLE001——任何复核失败都不得静默
  1410	        raise StationResultValidationError(
  1411	            f"jsonschema cross-check against {schema_path} failed: {exc}"
  1412	        ) from exc
