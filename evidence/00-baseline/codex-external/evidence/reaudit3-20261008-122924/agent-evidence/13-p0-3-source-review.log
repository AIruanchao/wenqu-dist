   449	class StationRegistry:
   450	    """版本化八站注册表：站 0-7 全集定义 + 一致性自检。
   451	
   452	    任何站定义变更（判据/TTL/工具插槽）都必须：递增 REGISTRY_VERSION、
   453	    同步 schemas/station-result-v2.schema.json 与规范文档、并重新冻结
   454	    已在跑的 run manifest（指纹变化即失效重跑——铁律 4）。
   455	    """
   456	
   457	    def __init__(self, stations: Iterable[StationSpec] = _DEFAULT_STATIONS) -> None:
   458	        specs = tuple(stations)
   459	        by_id: Dict[int, StationSpec] = {}
   460	        for spec in specs:
   461	            if not isinstance(spec.station_id, int) or not 0 <= spec.station_id <= 7:
   462	                raise ValueError(f"station_id must be int in [0,7], got {spec.station_id!r}")
   463	            if spec.station_id in by_id:
   464	                raise ValueError(f"duplicate station_id: {spec.station_id}")
   465	            by_id[spec.station_id] = spec
   466	        if sorted(by_id) != list(range(8)):
   467	            raise ValueError(
   468	                f"registry must define exactly stations 0..7, got {sorted(by_id)}"
   469	            )
   470	        self._stations = by_id
   471	        self.validate()
   472	
   473	    # -- 查询 ---------------------------------------------------------------
   474	    def get(self, station_id: int) -> StationSpec:
   475	        try:
   476	            return self._stations[station_id]
   477	        except KeyError:
   478	            raise KeyError(f"unknown station_id: {station_id}") from None
   479	
   480	    def all(self) -> Tuple[StationSpec, ...]:
   481	        return tuple(self._stations[i] for i in range(8))
   482	
   483	    def required_for(self, lane: str) -> Tuple[int, ...]:
   484	        if lane not in LANE_REQUIRED_STATIONS:
   485	            raise BugscanPlanError(f"unknown lane {lane!r}; expected one of {LANES}")
   486	        return LANE_REQUIRED_STATIONS[lane]
   487	
   488	    def ttl_for(self, station_id: int) -> int:
   489	        return self.get(station_id).ttl_days
   490	
   491	    def snapshot(self) -> Dict[str, Any]:
   492	        """注册表快照（嵌入 manifest 存档，保证判定可复现）。"""
   493	        return {
   494	            "registry_version": REGISTRY_VERSION,
   495	            "stations": {i: self._stations[i].to_dict() for i in range(8)},
   496	        }
   497	
   498	    def registry_digest(self) -> str:
   499	        return _hash_obj(self.snapshot())
   500	
   501	    # -- 自检 ---------------------------------------------------------------
   502	    def validate(self) -> None:
   503	        """一致性自检：TTL 双上限、判据三态齐全、工具/规则非空。"""
   504	        for spec in self.all():
   505	            cap = EVIDENCE_TTL_CAP_DAYS.get(spec.evidence_class)
   506	            if cap is None:
   507	                raise ValueError(
   508	                    f"station {spec.station_id}: unknown evidence_class "
   509	                    f"{spec.evidence_class!r} (expected one of "
   510	                    f"{sorted(EVIDENCE_TTL_CAP_DAYS)})"
   511	                )
   512	            if not 1 <= spec.ttl_days <= cap:
   513	                raise ValueError(
   514	                    f"station {spec.station_id} ({spec.slug}): ttl_days="
   515	                    f"{spec.ttl_days} violates 铁律4 cap {cap}d for "
   516	                    f"{spec.evidence_class}"
   517	                )
   518	            if not (spec.criteria.pass_ and spec.criteria.fail and spec.criteria.error):
   519	                raise ValueError(
   520	                    f"station {spec.station_id} ({spec.slug}): PASS/FAIL/ERROR "
   521	                    "criteria must all be non-empty"
   522	                )
   523	            if not spec.tools or not spec.rules:
   524	                raise ValueError(
   525	                    f"station {spec.station_id} ({spec.slug}): tools and rules "
   526	                    "must be non-empty"
   527	                )
   528	
   529	
   530	_DEFAULT_REGISTRY: Optional[StationRegistry] = None
   531	
   532	
   533	def default_registry() -> StationRegistry:
   534	    """进程级默认注册表（惰性单例；定义不可变，可安全共享）。"""
   535	    global _DEFAULT_REGISTRY
   536	    if _DEFAULT_REGISTRY is None:
   537	        _DEFAULT_REGISTRY = StationRegistry()
   538	    return _DEFAULT_REGISTRY
   539	
   540	
   541	# ---------------------------------------------------------------------------
   542	# 风险接受记录（降档唯一合法通道）
   543	# ---------------------------------------------------------------------------
   544	
   545	@dataclass(frozen=True)
   546	class RiskAcceptance:
   547	    """降档风险接受记录——五要素对齐 finding-event-v2 risk_acceptance。
   548	
   549	    approver（风险负责人）/ reason（理由，≥10 字）/ scope（影响范围）/
   550	    expiry（到期日，≤30 天日落）。缺任一要素或已过期 = 降档非法。
   551	    """
   552	
   553	    approver: str
   554	    reason: str
   555	    scope: str
   556	    expiry: str  # ISO-8601 date-time
   557	    compensating_controls: Tuple[str, ...] = ()
   558	
   559	    @classmethod
   560	    def from_mapping(cls, data: Mapping[str, Any]) -> "RiskAcceptance":
   561	        if not isinstance(data, Mapping):
   562	            raise RiskDowngradeError(
   563	                f"risk acceptance must be a mapping, got {type(data).__name__}"
   564	            )
   565	        missing = [k for k in ("approver", "reason", "scope", "expiry") if not data.get(k)]
   566	        if missing:
   567	            raise RiskDowngradeError(
   568	                f"risk acceptance missing required fields: {missing} "
   569	                "(负责人/理由/范围/到期 缺一不可)"
   570	            )
   571	        return cls(
   572	            approver=str(data["approver"]),
   573	            reason=str(data["reason"]),
   574	            scope=str(data["scope"]),
   575	            expiry=str(data["expiry"]),
   576	            compensating_controls=tuple(str(c) for c in data.get("compensating_controls", ())),
   577	        )
   578	
   579	    def validate(self, now: Optional[datetime] = None) -> datetime:
   580	        """校验五要素 + 日落约束；返回到期时刻。"""
   581	        now = now or _utc_now()
   582	        if not self.approver.strip():
   583	            raise RiskDowngradeError("risk acceptance approver (风险负责人) is empty")
   584	        if len(self.reason.strip()) < 10:
   585	            raise RiskDowngradeError(
   586	                f"risk acceptance reason too short ({len(self.reason.strip())} chars; "
   587	                "须 ≥10 字，对齐 finding-event-v2 minLength)"
   588	            )
   589	        if not self.scope.strip():
   590	            raise RiskDowngradeError("risk acceptance scope (影响范围) is empty")
   591	        expiry = _parse_iso(self.expiry, what="risk acceptance expiry")
   592	        if expiry <= now:
   593	            raise RiskDowngradeError(
   594	                f"risk acceptance expired at {self.expiry} (30 天日落——过期降档非法)"
   595	            )
   596	        if expiry > now + timedelta(days=RISK_ACCEPTANCE_MAX_DAYS):
   597	            raise RiskDowngradeError(
   598	                f"risk acceptance expiry {self.expiry} exceeds "
   599	                f"{RISK_ACCEPTANCE_MAX_DAYS}d sunset window"
   600	            )
   601	        return expiry
   602	
   603	    def to_dict(self) -> Dict[str, Any]:
   604	        out: Dict[str, Any] = {
   605	            "approver": self.approver,
   606	            "reason": self.reason,
   607	            "scope": self.scope,
   608	            "expiry": self.expiry,
   609	        }
   610	        if self.compensating_controls:
   611	            out["compensating_controls"] = list(self.compensating_controls)
   612	        return out
   613	
   614	
   615	# ---------------------------------------------------------------------------
   616	# BugscanPlanner——风险定级 → required 站集合
   617	# ---------------------------------------------------------------------------
   618	
   619	@dataclass(frozen=True)
   620	class BugscanPlan:
   621	    """一次 bugscan 的冻结计划（manifest 的 planning 段正源）。"""
   622	
   623	    lane_requested: str
   624	    lane_effective: str
   625	    required_stations: Tuple[int, ...]
   626	    convergence_rounds: int
   627	    escalated: bool
   628	    escalation_reasons: Tuple[str, ...]
   629	    downgrade: Optional[RiskAcceptance]
   630	    dropped_stations: Tuple[int, ...]
   631	    registry_version: str
   632	
   633	    def to_dict(self) -> Dict[str, Any]:
   634	        return {
   635	            "lane_requested": self.lane_requested,
   636	            "lane_effective": self.lane_effective,
   637	            "required_stations": list(self.required_stations),
   638	            "convergence_rounds": self.convergence_rounds,
   639	            "escalated": self.escalated,
   640	            "escalation_reasons": list(self.escalation_reasons),
   641	            "downgrade": self.downgrade.to_dict() if self.downgrade else None,
   642	            "dropped_stations": list(self.dropped_stations),
   643	            "registry_version": self.registry_version,
   644	        }
   645	
   646	
   647	class BugscanPlanner:
   648	    """根据风险定级生成 required 站集合（Codex W6A §7.1）。
   649	
   650	    升档：自动、只增不减——任何 SCOPE_FLAG_ESCALATION 命中即把档位拉到
   651	    该标志的最低档（铁律 1）。
   652	
   653	    降档：永不自动。必须显式给出 RiskAcceptance（负责人/理由/范围/到期，
   654	    30 天日落）且被移除站不得触碰底线 {0,1}；计划内嵌该记录以供审计。
   655	    """
   656	
   657	    def __init__(self, registry: Optional[StationRegistry] = None) -> None:
   658	        self._registry = registry or default_registry()
   659	
   660	    @property
   661	    def registry(self) -> StationRegistry:
   662	        return self._registry
   663	
   664	    # -- 定级 ---------------------------------------------------------------
   665	    @staticmethod
   666	    def resolve_lane(
   667	        lane: str,
   668	        scope_flags: Iterable[str] = (),
   669	    ) -> Tuple[str, bool, Tuple[str, ...]]:
   670	        """请求档 + 范围标志 → 生效档（只升不降）。"""
   671	        if lane not in _LANE_ORDER:
   672	            raise BugscanPlanError(f"unknown lane {lane!r}; expected one of {LANES}")
   673	        flags = tuple(scope_flags or ())
   674	        unknown = [f for f in flags if f not in SCOPE_FLAG_ESCALATION]
   675	        if unknown:
   676	            # fail-closed：未知范围标志意味着定级模型失配，禁止猜测。
   677	            raise BugscanPlanError(
   678	                f"unknown scope flags {unknown}; known: {sorted(SCOPE_FLAG_ESCALATION)}"
   679	            )
   680	        effective = lane
   681	        reasons: List[str] = []
   682	        for flag in flags:
   683	            floor = SCOPE_FLAG_ESCALATION[flag]
   684	            if _LANE_ORDER[floor] > _LANE_ORDER[effective]:
   685	                effective = floor
   686	                reasons.append(f"{flag}→{floor}")
   687	        return effective, effective != lane, tuple(reasons)
   688	
   689	    def plan(
   690	        self,
   691	        lane: str,
   692	        *,
   693	        scope_flags: Iterable[str] = (),
   694	        downgrade: Optional[Mapping[str, Any] | RiskAcceptance] = None,
   695	        downgrade_stations: Iterable[int] = (),
   696	        now: Optional[datetime] = None,
   697	    ) -> BugscanPlan:
   698	        """生成冻结计划。
   699	
   700	        - scope_flags 命中 → 自动升档（只增不减）。
   701	        - downgrade（映射或 RiskAcceptance）+ downgrade_stations → 显式降档：
   702	          记录五要素校验 + 日落校验；站 0/1 不可移除；只能移除生效档
   703	          required 集内的站。
   704	        """
   705	        effective, escalated, reasons = self.resolve_lane(lane, scope_flags)
   706	        base_set = set(self._registry.required_for(effective))
   707	        dropped: List[int] = []
   708	        drop_req = tuple(downgrade_stations or ())
   709	        acceptance: Optional[RiskAcceptance] = None
   710	        if downgrade is None:
   711	            if drop_req:
   712	                raise RiskDowngradeError(
   713	                    f"removing stations {list(drop_req)} requires a risk acceptance "
   714	                    "record (降档须记录负责人/理由/范围/到期)"
   715	                )
   716	        else:
   717	            acceptance = (
   718	                downgrade
   719	                if isinstance(downgrade, RiskAcceptance)
   720	                else RiskAcceptance.from_mapping(downgrade)
   721	            )
   722	            acceptance.validate(now)
   723	            if not drop_req:
   724	                raise RiskDowngradeError(
   725	                    "downgrade record provided but downgrade_stations is empty"
   726	                )
   727	            for station_id in drop_req:
   728	                if station_id not in base_set:
   729	                    raise RiskDowngradeError(
   730	                        f"cannot drop station {station_id}: not in "
   731	                        f"{effective} required set {sorted(base_set)}"
   732	                    )
   733	                if station_id in DOWNGRADE_FLOOR_STATIONS:
   734	                    raise RiskDowngradeError(
   735	                        f"cannot drop station {station_id}: stations "
   736	                        f"{sorted(DOWNGRADE_FLOOR_STATIONS)} are never removable "
   737	                        "(站0 范围冻结与站1 源闸不可省)"
   738	                    )
   739	                dropped.append(station_id)
   740	            base_set -= set(dropped)
   741	        required = tuple(sorted(base_set))
   742	        return BugscanPlan(
   743	            lane_requested=lane,
   744	            lane_effective=effective,
   745	            required_stations=required,
   746	            convergence_rounds=LANE_CONVERGENCE_ROUNDS[effective],
   747	            escalated=escalated,
   748	            escalation_reasons=reasons,
   749	            downgrade=acceptance,
   750	            dropped_stations=tuple(dropped),
   751	            registry_version=REGISTRY_VERSION,
   752	        )
   753	
   754	    # -- 站0 冻结（委托模块级函数，见下） -----------------------------------
   755	    def freeze_run_manifest(
   756	        self,
   757	        plan: BugscanPlan,
   758	        *,
   759	        run_id: str,
   760	        project_id: str,
   761	        commit_sha: str,
   762	        environment: str,
   763	        scope: Iterable[str] | Mapping[str, Any],
   764	        ruleset: Mapping[str, Any] | str,
   765	        data_config: Mapping[str, Any] | str,
   766	        base_sha: Optional[str] = None,
   767	        lockfile_hash: Optional[str] = None,
   768	        now: Optional[datetime] = None,
   769	    ) -> "RunManifest":
   770	        return freeze_run_manifest(
   771	            plan,
   772	            run_id=run_id,
   773	            project_id=project_id,
   774	            commit_sha=commit_sha,
   775	            environment=environment,
   776	            scope=scope,
   777	            ruleset=ruleset,
   778	            data_config=data_config,
   779	            base_sha=base_sha,
   780	            lockfile_hash=lockfile_hash,
   781	            now=now,
   782	            registry=self._registry,
   783	        )
