     1	# -*- coding: utf-8 -*-
     2	"""统一 Gate 聚合器（Codex W3B）。
     3	
     4	消费流水线各 station 产出的 station-result JSON，聚合为整线统一的 gate 判定。
     5	
     6	station-result 输入契约（add() 的每个元素）::
     7	
     8	    {
     9	      "station":     "lint",        # 必填：站点名（required_stations 成员或旁路站点）
    10	      "outcome":     "PASS",        # 必填：见下方别名表；未知/缺失一律按硬失败
    11	      "sha":         "<full-sha>",  # 必填（亦接受 target_sha / commit_sha）
    12	      "environment": "staging",     # 必填：须与构造器 environment 完全一致
    13	    }
    14	
    15	outcome 别名表（大小写不敏感）：
    16	    PASS/PASSED/OK/SUCCESS/GREEN                            -> PASS
    17	    CONDITIONAL/WARN/WARNING/SOFT_PASS/PASS_WITH_WARNINGS   -> CONDITIONAL
    18	    FAIL/FAILED/FAILURE/ERROR/BLOCKED/TIMEOUT/未知/缺失     -> 硬失败（整线 BLOCKED）
    19	
    20	硬约束（不可降级）：
    21	    C1 任一 required 站非 PASS -> 整线非 PASS；
    22	    C2 任一站点证据 SHA 与 target_sha 不一致（或缺失、无法绑定目标）-> BLOCKED；
    23	    C3 分母缩水：required 站未全部上报 -> BLOCKED；
    24	    C4 CONDITIONAL != PASS：条件通过永不映射为绿判定 / GitHub success；
    25	    C5 环境不一致 / 结构残缺 / 同站冲突证据 -> BLOCKED（宁可阻断，不猜证据）。
    26	
    27	technical_eligible 语义：True 仅表示技术硬门（C2/C3/C5 及“无任何站点硬失败”）全部
    28	通过；与 aggregate_outcome == PASS 不等价——CONDITIONAL 时 technical_eligible 可为
    29	True，但放行判断必须且只能以 aggregate_outcome == PASS 为准。
    30	
    31	GitHub 状态映射（to_github_status）：
    32	    PASS        -> state=success  / conclusion=success
    33	    CONDITIONAL -> state=failure  / conclusion=action_required  # 条件项须人工处置，绝不上绿
    34	    BLOCKED     -> state=failure  / conclusion=failure
    35	"""
    36	
    37	from __future__ import annotations
    38	
    39	from typing import Any, Dict, List, Mapping, Optional, Set
    40	
    41	__all__ = ["GateAggregator", "PASS", "CONDITIONAL", "BLOCKED"]
    42	
    43	PASS = "PASS"
    44	CONDITIONAL = "CONDITIONAL"
    45	BLOCKED = "BLOCKED"
    46	
    47	_PASS_ALIASES = frozenset({"PASS", "PASSED", "OK", "SUCCESS", "GREEN"})
    48	_CONDITIONAL_ALIASES = frozenset(
    49	    {"CONDITIONAL", "WARN", "WARNING", "SOFT_PASS", "PASS_WITH_WARNINGS"}
    50	)
    51	_SHA_FIELDS = ("sha", "target_sha", "commit_sha")
    52	
    53	_GITHUB_STATE = {
    54	    PASS: ("success", "success"),
    55	    CONDITIONAL: ("failure", "action_required"),
    56	    BLOCKED: ("failure", "failure"),
    57	}
    58	
    59	
    60	class GateAggregator:
    61	    """消费 station-result JSON，输出整线统一 gate 判定。
    62	
    63	    用法::
    64	
    65	        agg = GateAggregator(required_stations={"lint", "test"},
    66	                             target_sha="abc...", environment="staging")
    67	        agg.add(station_result_1).add(station_result_2)
    68	        verdict = agg.aggregate()          # aggregate_outcome / technical_eligible / reason ...
    69	        status = agg.to_github_status()    # {"state": ..., "conclusion": ..., "description": ...}
    70	    """
    71	
    72	    def __init__(self, required_stations: Set[str], target_sha: str, environment: str) -> None:
    73	        target_sha = str(target_sha or "").strip().lower()
    74	        if not target_sha:
    75	            raise ValueError("target_sha is required: gate evidence must be bound to a SHA")
    76	        if not isinstance(environment, str) or not environment:
    77	            raise ValueError("environment is required: gate evidence must be bound to an environment")
    78	
    79	        self.required_stations: frozenset = frozenset(
    80	            s.strip() for s in required_stations if isinstance(s, str) and s.strip()
    81	        )
    82	        self.target_sha: str = target_sha
    83	        self.environment: str = environment
    84	
    85	        # 内部登记簿
    86	        self._stations: Dict[str, Dict[str, Any]] = {}
    87	        self._duplicates: List[str] = []
    88	        self._conflicts: List[Dict[str, Any]] = []
    89	        self._malformed: List[Dict[str, Any]] = []
    90	        self._sha_violations: List[Dict[str, Any]] = []
    91	        self._env_violations: List[Dict[str, Any]] = []
    92	
    93	    # ------------------------------------------------------------------ #
    94	    # 登记阶段
    95	    # ------------------------------------------------------------------ #
    96	    @staticmethod
    97	    def _normalize_outcome(raw: Any) -> str:
    98	        """归一化 outcome；未知/缺失一律按 BLOCKED（硬失败）处理，绝不猜成好结果。"""
    99	        token = str(raw if raw is not None else "").strip().upper()
   100	        if token in _PASS_ALIASES:
   101	            return PASS
   102	        if token in _CONDITIONAL_ALIASES:
   103	            return CONDITIONAL
   104	        return BLOCKED
   105	
   106	    def add(self, station_result: dict) -> "GateAggregator":
   107	        """登记一条 station-result；返回 self 以便链式调用。
   108	
   109	        重复站点：内容完全一致视为幂等上报（忽略）；不一致视为冲突证据，
   110	        两者都会在 aggregate() 时以 BLOCKED 或备注形式体现，绝不静默择优。
   111	        """
   112	        if not isinstance(station_result, Mapping):
   113	            self._malformed.append(
   114	                {"reason": "not_a_json_object", "entry": repr(station_result)[:200]}
   115	            )
   116	            return self
   117	
   118	        station = station_result.get("station")
   119	        if not isinstance(station, str) or not station.strip():
   120	            self._malformed.append({
   121	                "reason": "missing_field:station",
   122	                "entry_keys": sorted(map(str, station_result.keys())),
   123	            })
   124	            return self
   125	        station = station.strip()
   126	
   127	        outcome = station_result.get("outcome")
   128	        sha = ""
   129	        for field in _SHA_FIELDS:
   130	            value = station_result.get(field)
   131	            if isinstance(value, str) and value.strip():
   132	                sha = value.strip().lower()
   133	                break
   134	        environment = station_result.get("environment")
   135	
   136	        entry = {
   137	            "station": station,
   138	            "outcome": self._normalize_outcome(outcome),
   139	            "outcome_raw": str(outcome if outcome is not None else "").strip(),
   140	            "sha": sha,
   141	            "environment": environment,
   142	            "required": station in self.required_stations,
   143	        }
   144	
   145	        previous = self._stations.get(station)
   146	        if previous is not None:
   147	            identical = (
   148	                previous["outcome"] == entry["outcome"]
   149	                and previous["sha"] == entry["sha"]
   150	                and previous["environment"] == entry["environment"]
   151	            )
   152	            if identical:
   153	                self._duplicates.append(station)
   154	            else:
   155	                self._conflicts.append({"station": station, "first": previous, "second": entry})
   156	            return self  # 首条为准；冲突已记账，aggregate() 时 BLOCKED
   157	
   158	        self._stations[station] = entry
   159	
   160	        # C2：SHA 证据绑定（缺失同样无法绑定 -> 违规）
   161	        if sha != self.target_sha:
   162	            self._sha_violations.append({
   163	                "station": station,
   164	                "reason": "missing_sha" if not sha else "sha_mismatch",
   165	                "sha": sha or None,
   166	                "expected": self.target_sha,
   167	            })
   168	        # C5：环境证据绑定（缺失同样无法绑定 -> 违规）
   169	        if environment != self.environment:
   170	            self._env_violations.append({
   171	                "station": station,
   172	                "reason": "missing_environment" if environment is None else "environment_mismatch",
   173	                "environment": environment,
   174	                "expected": self.environment,
   175	            })
   176	        return self
   177	
   178	    # ------------------------------------------------------------------ #
   179	    # 判定阶段
   180	    # ------------------------------------------------------------------ #
   181	    def aggregate(self) -> Dict[str, Any]:
   182	        """聚合为统一 gate 判定；纯计算，不修改登记状态。"""
   183	        reasons: List[str] = []
   184	        hard = False
   185	
   186	        def block(reason: str) -> None:
   187	            nonlocal hard
   188	            hard = True
   189	            reasons.append(reason)
   190	
   191	        # 1) C2/C5：证据完整性硬门
   192	        if self._sha_violations:
   193	            detail = "; ".join(f"{v['station']}:{v['reason']}" for v in self._sha_violations)
   194	            block(f"sha_evidence_violation [{detail}]")
   195	        if self._env_violations:
   196	            detail = "; ".join(f"{v['reason']}" for v in self._env_violations)
   197	            stations = ",".join(sorted({v["station"] for v in self._env_violations}))
   198	            block(f"environment_evidence_violation [{stations}] ({detail})")
   199	        if self._malformed:
   200	            block(f"malformed_station_result x{len(self._malformed)} "
   201	                  f"[first={self._malformed[0]['reason']}]")
   202	        if self._conflicts:
   203	            names = ",".join(sorted({c["station"] for c in self._conflicts}))
   204	            block(f"duplicate_station_conflict [{names}]")
   205	
   206	        # 2) C3：分母缩水（required 站未全部上报）
   207	        reported = set(self._stations)
   208	        missing_required = sorted(self.required_stations - reported)
   209	        bypass_reported = sorted(reported - self.required_stations)
   210	        if missing_required:
   211	            block("denominator_shrinkage: missing required stations [" +
   212	                  ",".join(missing_required) + "]")
   213	
   214	        # 3) 站点硬失败（required 或旁路站一视同仁；未知 outcome 已归入硬失败）
   215	        hard_failed = sorted(s for s, e in self._stations.items() if e["outcome"] == BLOCKED)
   216	        if hard_failed:
   217	            block("station_hard_failure [" + ",".join(hard_failed) + "]")
   218	
   219	        # 4) C4：条件项（软，不 block 但整线不得为 PASS）
   220	        conditional = sorted(s for s, e in self._stations.items() if e["outcome"] == CONDITIONAL)
   221	        if conditional:
   222	            reasons.append("conditional_stations [" + ",".join(conditional) + "]")
   223	
   224	        if hard:
   225	            outcome = BLOCKED
   226	        elif conditional:
   227	            outcome = CONDITIONAL
   228	        else:
   229	            outcome = PASS
   230	
   231	        if not self.required_stations:
   232	            # P0-3 修：零分母真空 PASS 是 fail-closed 违规——没有 required 站的 Gate 必须拒绝
   233	            outcome = BLOCKED
   234	            reason = "BLOCKED: no required stations configured — refusing vacuous PASS (P0-3 fix)"
   235	        elif outcome == PASS:
   236	            reason = f"all {len(self.required_stations)} required stations PASS"
   237	        else:
   238	            reason = reasons[0] if reasons else outcome
   239	
   240	        stations_summary = {
   241	            s: {
   242	                "outcome": e["outcome"],
   243	                "required": e["required"],
   244	                "sha_bound": e["sha"] == self.target_sha,
   245	                "environment_ok": e["environment"] == self.environment,
   246	            }
   247	            for s, e in sorted(self._stations.items())
   248	        }
   249	
   250	        return {
   251	            "aggregate_outcome": outcome,
   252	            "technical_eligible": (not hard) and outcome == PASS,  # P0-3: zero-required must also be false
   253	            "reason": reason,
   254	            "reasons": reasons,
   255	            "counts": {
   256	                "required_total": len(self.required_stations),
   257	                "required_reported": len(self.required_stations & reported),
   258	                "required_missing": len(missing_required),
   259	                "bypass_stations": len(bypass_reported),
   260	                "duplicates_ignored": len(self._duplicates),
   261	                "conflicts": len(self._conflicts),
   262	                "malformed": len(self._malformed),
   263	            },
   264	            "stations": stations_summary,
   265	            "target_sha": self.target_sha,
   266	            "environment": self.environment,
   267	        }
   268	
   269	    def to_github_status(self, aggregate_result: Optional[Dict[str, Any]] = None) -> Dict[str, str]:
   270	        """映射为 GitHub 状态：Commit Status `state` + Checks API `conclusion` 双口径。
   271	
   272	        映射表（CONDITIONAL 绝不上绿，见 C4）：
   273	            PASS->success/success；CONDITIONAL->failure/action_required；BLOCKED->failure/failure
   274	        """
   275	        result = aggregate_result if aggregate_result is not None else self.aggregate()
   276	        outcome = result.get("aggregate_outcome", BLOCKED)
   277	        state, conclusion = _GITHUB_STATE.get(outcome, ("failure", "failure"))
   278	        description = f"gate {outcome}: {result.get('reason', '')}".strip()
   279	        return {
   280	            "state": state,                    # Commit Status API: success/failure/pending/error
   281	            "conclusion": conclusion,          # Checks API conclusion
   282	            "description": description[:140],  # GitHub description 上限 140 字符
   283	            "context": f"wenqu-gate/{self.environment}",
   284	            "target_sha": self.target_sha,
   285	        }
