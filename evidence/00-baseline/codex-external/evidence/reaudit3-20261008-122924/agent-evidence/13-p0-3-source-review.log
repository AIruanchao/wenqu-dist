  1415	# ---------------------------------------------------------------------------
  1416	# SourceGateAdapter——站1 源闸适配（Codex W6A §15.2）
  1417	# ---------------------------------------------------------------------------
  1418	
  1419	class SourceGateAdapter:
  1420	    """站1 适配器：消费 SourceGate 在 exact-SHA 上的既有结果。
  1421	
  1422	    本适配器不运行任何门禁、不重新解释工具输出——只做三件事：
  1423	    1. 绑定校验：gate_result.commit_sha 必须等于冻结 manifest 的 commit_sha
  1424	       （证据/审批不得跨 SHA 复用——不变量 #5），不匹配即抛
  1425	       SourceGateShaMismatch。
  1426	    2. 时效校验：gate 结束时刻 + 站 TTL ≥ now（铁律 4），过期抛
  1427	       EvidenceStaleError。
  1428	    3. 机械映射：退出码 → (execution_status, policy_verdict)，按
  1429	       wenqu-vNext-contract §7 契约表（SOURCE_GATE_EXIT_CODE_MAPPING）；
  1430	       退出码不在契约内 → GateResultMalformed（fail-closed）。
  1431	
  1432	    身份三源（commit_sha/environment/scope_hash 等）一律取自冻结 manifest
  1433	    正源，绝不采信 gate_result 自报身份。
  1434	    """
  1435	
  1436	    STATION_ID = 1
  1437	
  1438	    def __init__(
  1439	        self,
  1440	        manifest: RunManifest,
  1441	        *,
  1442	        registry: Optional[StationRegistry] = None,
  1443	        now: Optional[datetime] = None,
  1444	    ) -> None:
  1445	        if not isinstance(manifest, RunManifest):
  1446	            raise SourceGateError(
  1447	                f"manifest must be RunManifest, got {type(manifest).__name__}"
  1448	            )
  1449	        self._manifest = manifest
  1450	        self._registry = registry or default_registry()
  1451	        self._now = now
  1452	
  1453	    # -- 输入契约 -----------------------------------------------------------
  1454	    @staticmethod
  1455	    def _extract_gate_fields(gate_result: Mapping[str, Any]) -> Dict[str, Any]:
  1456	        if not isinstance(gate_result, Mapping):
  1457	            raise GateResultMalformed(
  1458	                f"gate_result must be a mapping, got {type(gate_result).__name__}"
  1459	            )
  1460	        missing = [k for k in ("commit_sha", "exit_code") if k not in gate_result]
  1461	        if missing:
  1462	            raise GateResultMalformed(f"gate_result missing fields: {missing}")
  1463	        try:
  1464	            sha = _require_sha40(gate_result["commit_sha"], what="gate_result.commit_sha")
  1465	        except ValueError as exc:
  1466	            raise GateResultMalformed(str(exc)) from exc
  1467	        exit_code = gate_result["exit_code"]
  1468	        if isinstance(exit_code, bool) or not isinstance(exit_code, int):
  1469	            raise GateResultMalformed(
  1470	                f"gate_result.exit_code must be an int, got {exit_code!r}"
  1471	            )
  1472	        if exit_code not in SOURCE_GATE_EXIT_CODE_MAPPING:
  1473	            raise GateResultMalformed(
  1474	                f"gate_result.exit_code {exit_code} not in §7 contract "
  1475	                f"{sorted(SOURCE_GATE_EXIT_CODE_MAPPING)} (fail-closed)"
  1476	            )
  1477	        tool = gate_result.get("tool")
  1478	        if not isinstance(tool, Mapping) or not tool.get("name") or not tool.get("version"):
  1479	            raise GateResultMalformed(
  1480	                "gate_result.tool must be an object with non-empty name/version"
  1481	            )
  1482	        for ts_key in ("started_at", "ended_at"):
  1483	            if ts_key not in gate_result:
  1484	                raise GateResultMalformed(f"gate_result missing {ts_key}")
  1485	            try:
  1486	                _parse_iso(gate_result[ts_key], what=f"gate_result.{ts_key}")
  1487	            except ValueError as exc:
  1488	                raise GateResultMalformed(str(exc)) from exc
  1489	        components = gate_result.get("components", [])
  1490	        if not isinstance(components, list) or not all(
  1491	            isinstance(c, Mapping) and isinstance(c.get("name"), str) for c in components
  1492	        ):
  1493	            raise GateResultMalformed(
  1494	                "gate_result.components must be a list of objects with a name"
  1495	            )
  1496	        return {
  1497	            "commit_sha": sha,
  1498	            "exit_code": exit_code,
  1499	            "tool": dict(tool),
  1500	            "started_at": gate_result["started_at"],
  1501	            "ended_at": gate_result["ended_at"],
  1502	            "argv_digest": gate_result.get("argv_digest"),
  1503	            "components": [dict(c) for c in components],
  1504	        }
  1505	
  1506	    # -- 适配 ---------------------------------------------------------------
  1507	    def adapt(self, gate_result: Mapping[str, Any]) -> Dict[str, Any]:
  1508	        """消费源闸结果 → 站1 station-result-v2（严格 schema 合规）。"""
  1509	        parsed = self._extract_gate_fields(gate_result)
  1510	
  1511	        # 1) exact-SHA 绑定（不匹配=证据不属于本 run，拒绝而非降级）
  1512	        if parsed["commit_sha"] != self._manifest.commit_sha:
  1513	            raise SourceGateShaMismatch(
  1514	                f"gate ran at {parsed['commit_sha']} but manifest froze "
  1515	                f"{self._manifest.commit_sha}——证据不得跨 SHA 复用，请在冻结 SHA 重跑源闸"
  1516	            )
  1517	
  1518	        # 2) 时效（铁律 4 双上限，按站 TTL）
  1519	        now = self._now or _utc_now()
  1520	        ttl_days = self._registry.ttl_for(self.STATION_ID)
  1521	        ended = _parse_iso(parsed["ended_at"], what="gate_result.ended_at")
  1522	        fresh_until = ended + timedelta(days=ttl_days)
  1523	        if fresh_until < now:
  1524	            raise EvidenceStaleError(
  1525	                f"gate evidence aged out: ended {parsed['ended_at']} + TTL "
  1526	                f"{ttl_days}d < now {_iso_z(now)}——重跑源闸后重新适配"
  1527	            )
  1528	
  1529	        # 3) §7 退出码 → 双轴（机械映射，不自行判定）
  1530	        execution_status, policy_verdict = SOURCE_GATE_EXIT_CODE_MAPPING[parsed["exit_code"]]
  1531	
  1532	        # 覆盖：组件级分母（未给组件时以门整体为单件——denominator 不缩水）
  1533	        components = parsed["components"]
  1534	        if components:
  1535	            denominator = len(components)
  1536	            scanned = sum(
  1537	                1 for c in components
  1538	                if str(c.get("status", "COMPLETED")).upper() != "NOT_RUN"
  1539	            )
  1540	        else:
  1541	            denominator = scanned = 1
  1542	        shrink = scanned < denominator
  1543	        if shrink:
  1544	            # 分母缩水守卫：整站 BLOCKED，绝不记 PASS（schema $comment）。
  1545	            execution_status = "BLOCKED"
  1546	            policy_verdict = "NOT_EVALUATED"
  1547	        assertion = "PASS" if (policy_verdict == "PASS" and not shrink) else (
  1548	            "FAIL" if policy_verdict == "FAIL" else "ERROR"
  1549	        )
  1550	
  1551	        manifest_identity: Dict[str, Any] = {
  1552	            "project_id": self._manifest.project_id,
  1553	            "commit_sha": self._manifest.commit_sha,
  1554	            "environment": self._manifest.environment,
  1555	            "scope_hash": self._manifest.scope_hash,
  1556	            "ruleset_hash": self._manifest.ruleset_hash,
  1557	            "data_config_hash": self._manifest.data_config_hash,
  1558	        }
  1559	        if self._manifest.lockfile_hash:
  1560	            manifest_identity["lockfile_hash"] = self._manifest.lockfile_hash
  1561	
  1562	        tool = {
  1563	            "name": str(parsed["tool"]["name"]),
  1564	            "version": str(parsed["tool"]["version"]),
  1565	        }
  1566	        if parsed["tool"].get("digest"):
  1567	            tool["digest"] = str(parsed["tool"]["digest"])
  1568	
  1569	        execution: Dict[str, Any] = {
  1570	            "argv_digest": str(parsed["argv_digest"]) if parsed["argv_digest"]
  1571	            else _argv_digest([tool["name"], self._manifest.run_id]),
  1572	            "started_at": parsed["started_at"],
  1573	            "ended_at": parsed["ended_at"],
  1574	            "actual_exit_code": parsed["exit_code"],
  1575	            "expected_exit_set": [0],
  1576	            "assertion_verdict": assertion,
  1577	        }
  1578	
  1579	        return build_station_result(
  1580	            run_id=self._manifest.run_id,
  1581	            station_id=self.STATION_ID,
  1582	            attempt_id=_make_attempt_id(self._manifest.run_id, "st1"),
  1583	            execution_status=execution_status,
  1584	            policy_verdict=policy_verdict,
  1585	            identity=manifest_identity,
  1586	            tool=tool,
  1587	            execution=execution,
  1588	            coverage={"denominator": denominator, "scanned": scanned},
  1589	            finding_ids=[],
  1590	        )
  1591	
