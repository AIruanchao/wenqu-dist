   201	# ---------------------------------------------------------------------------
   202	# 基础工具：canonical JSON + 哈希 + 时间
   203	# ---------------------------------------------------------------------------
   204	
   205	def _canonical_json(obj: Any) -> str:
   206	    return json.dumps(obj, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
   207	
   208	
   209	def _sha256_hex(data: bytes) -> str:
   210	    return hashlib.sha256(data).hexdigest()
   211	
   212	
   213	def _hash_obj(obj: Any) -> str:
   214	    return _sha256_hex(_canonical_json(obj).encode("utf-8"))
   215	
   216	
   217	def _utc_now() -> datetime:
   218	    return datetime.now(timezone.utc)
   219	
   220	
   221	def _iso_z(dt: datetime) -> str:
   222	    return dt.astimezone(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")
   223	
   224	
   225	def _parse_iso(value: str, *, what: str) -> datetime:
   226	    if not isinstance(value, str) or not value:
   227	        raise ValueError(f"{what} must be a non-empty ISO-8601 string")
   228	    text = value.strip()
   229	    if text.endswith("Z"):
   230	        text = text[:-1] + "+00:00"
   231	    try:
   232	        dt = datetime.fromisoformat(text)
   233	    except ValueError as exc:
   234	        raise ValueError(f"{what} is not valid ISO-8601: {value!r}") from exc
   235	    if dt.tzinfo is None:
   236	        dt = dt.replace(tzinfo=timezone.utc)
   237	    return dt.astimezone(timezone.utc)
   238	
   239	
   240	def _require_sha40(value: str, *, what: str) -> str:
   241	    if not isinstance(value, str) or not _RE_SHA40.match(value):
   242	        raise ValueError(f"{what} must be a 40-char lowercase hex commit SHA, got {value!r}")
   243	    return value
   244	
   245	
   246	def _hash_or_digest(value: Any, *, what: str, required: bool = True) -> Optional[str]:
   247	    """dict → canonical 哈希；64-hex 字符串 → 原样；None 且非必需 → None。"""
   248	    if value is None:
   249	        if required:
   250	            raise ValueError(f"{what} is required (dict or 64-hex digest)")
   251	        return None
   252	    if isinstance(value, Mapping):
   253	        return _hash_obj(dict(value))
   254	    if isinstance(value, str) and _RE_SHA64.match(value):
   255	        return value
   256	    raise ValueError(f"{what} must be a mapping or 64-hex digest, got {type(value).__name__}")
   257	
