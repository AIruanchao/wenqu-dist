    74	command -v psql >/dev/null && echo "✓ psql（哨兵/守护需要）" || echo "△ 缺 psql（仅影响 DB 类组件）"
    75	python3 -c "import psycopg2" 2>/dev/null && echo "✓ psycopg2（守护进程需要）" || echo "△ 缺 psycopg2：pip3 install psycopg2-binary"
    76	[ -f "$PREFIX/bin/tla2tools.jar" ] && echo "✓ TLA+ 工具链" || echo "△ 无 tla2tools.jar（仅影响形式化验证组件）"
    77	command -v z3 >/dev/null && echo "✓ Z3 定理证明器" || echo "△ 缺 z3（brew install z3，仅影响 SMT 组件）"
    78	
    79	# 6. 自检（P0-7 修：新装预期警告不中止；关键件损坏才中止）
    80	echo "── 自检 ──"
    81	DOC_OUT=$(WENQU_HOME="$PREFIX" bash "$SRC/bin/wenqu" doctor 2>&1 || true)
    82	if echo "$DOC_OUT" | grep -q "✗ 缺.*必需\|✗.*不可导入\|✗.*不存在"; then
    83	  echo "✗ 安装自检失败——关键件缺失，安装中止" >&2
    84	  echo "$DOC_OUT" | grep "✗" | tail -3 >&2
    85	  exit 1
    86	else
    87	  echo "✓ 安装自检通过（配置警告不影响安装——配置后 wenqu doctor 复检）"
    88	fi
    89	
    90	echo "
    91	安装完成。三步上手：
    92	  1. 编辑 $PREFIX/env —— 填你的仓库/DB/告警参数
    93	  2. cd 你的项目 && wenqu init      —— 初始化项目级质量体系
    94	  3. wenqu status                   —— 查看全组件状态
    95	"
