    67	  cp "$PREFIX/env.example" "$PREFIX/env"
    68	fi
    69	echo "✓ 配置：$PREFIX/env（编辑后 wenqu doctor 校验）"
    70	
    71	# 5. 依赖探测（只提示不强装）
