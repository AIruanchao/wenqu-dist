    77	
    78	def _sha256_file(path: str) -> str:
    79	    digest = hashlib.sha256()
    80	    with open(path, "rb") as fh:
    81	        for chunk in iter(lambda: fh.read(_CHUNK), b""):
    82	            digest.update(chunk)
    83	    return digest.hexdigest()
    84	
    85	
    86	def _collect_files(root: str) -> List[str]:
    87	    """收集 root 下全部常规文件的相对路径（排序，确定性遍历）。"""
    88	    found: List[str] = []
    89	    for dirpath, dirnames, filenames in os.walk(root):
    90	        dirnames.sort()
    91	        for name in sorted(filenames):
    92	            found.append(os.path.relpath(os.path.join(dirpath, name), root))
    93	    return found
    94	
