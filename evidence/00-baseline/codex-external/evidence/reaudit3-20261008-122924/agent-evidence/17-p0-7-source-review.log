    18	mkdir -p "$PREFIX/lib/wenqu_core" "$PREFIX/schemas" "$PREFIX/dashboard"
    19	for f in "$SRC"/wenqu_core/*.py; do
    20	  [ -f "$f" ] && cp "$f" "$PREFIX/lib/wenqu_core/"
    21	done
