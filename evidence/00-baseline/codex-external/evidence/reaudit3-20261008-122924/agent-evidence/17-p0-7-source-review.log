    96	class DeployManager:
    97	    """原子部署管理器：build -> verify -> switch（-> 安装自检）-> rollback。"""
    98	
    99	    def __init__(self, releases_root: str, current_link: str,
   100	                 install_self_check: Optional[Callable[[str], bool]] = None) -> None:
   101	        self.releases_root = os.path.abspath(releases_root)
   102	        self.current_link = os.path.abspath(current_link)
   103	        self.install_self_check = install_self_check
   104	
   105	    # ------------------------------------------------------------------ #
   106	    # 构建：不可变 release 目录 + manifest
   107	    # ------------------------------------------------------------------ #
   108	    def build(self, source_dir: str) -> Dict[str, Any]:
   109	        """将 source_dir 构建为不可变 release 目录（全文件 SHA256 manifest）。
   110	
   111	        D1：staging 全新构建 + rename 原子发布；绝不向既有 release 写入/覆盖。
   112	        同秒同内容重复构建 -> 幂等复用已存在且完好的 release（reused=True）；
   113	        release_id 冲突但内容 divergent/损坏 -> BuildError。
   114	        """
   115	        source = os.path.abspath(source_dir)
   116	        if not os.path.isdir(source):
   117	            raise BuildError(f"source_dir not found: {source}")
   118	        os.makedirs(self.releases_root, exist_ok=True)
   119	
   120	        rel_files = _collect_files(source)
   121	        staging = tempfile.mkdtemp(prefix=".staging-", dir=self.releases_root)
   122	        try:
   123	            entries: List[Dict[str, Any]] = []
   124	            digest = hashlib.sha256()
   125	            for rel in rel_files:
   126	                src = os.path.join(source, rel)
   127	                dst = os.path.join(staging, rel)
   128	                os.makedirs(os.path.dirname(dst), exist_ok=True)
   129	                file_hash = self._copy_stream_hash(src, dst)  # 逐文件流式复制，非 cp -R
   130	                entries.append({"path": rel, "sha256": file_hash, "size": os.path.getsize(dst)})
   131	                digest.update(rel.encode("utf-8") + b"\0" + file_hash.encode("ascii") + b"\0")
   132	            content_digest = digest.hexdigest()
   133	
   134	            release_id = f"{time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())}-{content_digest[:12]}"
   135	            final_dir = os.path.join(self.releases_root, release_id)
   136	
   137	            manifest = {
   138	                "release_id": release_id,
   139	                "created_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
   140	                "source_dir": source,
   141	                "content_digest": content_digest,
   142	                "files": sorted(entries, key=lambda e: e["path"]),
   143	            }
   144	            manifest_path = os.path.join(staging, MANIFEST_NAME)
   145	            with open(manifest_path, "w", encoding="utf-8") as fh:
   146	                json.dump(manifest, fh, ensure_ascii=False, indent=2, sort_keys=True)
   147	                fh.write("\n")
   148	
   149	            # P0-7 修：保留执行位——脚本/shebang 类 0555，其他 0444
   150	            for e in manifest["files"]:
   151	                fpath = os.path.join(staging, e["path"])
   152	                _is_exec = e["path"].endswith(".sh") or (
   153	                    e["path"].endswith(".py")
   154	                    and os.path.getsize(fpath) > 2
   155	                    and open(fpath, "rb").read(2) == b"#!"
   156	                )
   157	                os.chmod(fpath, 0o555 if _is_exec else 0o444)
   158	            os.chmod(manifest_path, 0o444)
   159	
   160	            if os.path.exists(final_dir):
   161	                # 幂等复用：仅当既有 release 完好且内容摘要一致
   162	                if self._reusable(final_dir, content_digest):
   163	                    shutil.rmtree(staging, ignore_errors=True)
   164	                    with open(os.path.join(final_dir, MANIFEST_NAME), encoding="utf-8") as fh:
   165	                        existing = json.load(fh)
   166	                    return {
   167	                        "release_dir": final_dir,
   168	                        "manifest_path": os.path.join(final_dir, MANIFEST_NAME),
   169	                        "release_id": release_id,
   170	                        "content_digest": content_digest,
   171	                        "files": len(existing.get("files", [])),
   172	                        "reused": True,
   173	                    }
   174	                raise BuildError(
   175	                    f"release_id collision with divergent/broken existing release: {final_dir}")
   176	
   177	            os.rename(staging, final_dir)  # D3：同目录 rename，原子发布
   178	        except BaseException:
   179	            shutil.rmtree(staging, ignore_errors=True)
   180	            raise
   181	
   182	        return {
   183	            "release_dir": final_dir,
   184	            "manifest_path": os.path.join(final_dir, MANIFEST_NAME),
   185	            "release_id": release_id,
   186	            "content_digest": content_digest,
   187	            "files": len(entries),
   188	            "reused": False,
   189	        }
   190	
   191	    @staticmethod
   192	    def _copy_stream_hash(src: str, dst: str) -> str:
   193	        """流式复制并计算 SHA256（边写边哈希，单次读盘）。"""
   194	        digest = hashlib.sha256()
   195	        with open(src, "rb") as fsrc, open(dst, "wb") as fdst:
   196	            for chunk in iter(lambda: fsrc.read(_CHUNK), b""):
   197	                digest.update(chunk)
   198	                fdst.write(chunk)
   199	        return digest.hexdigest()
   200	
   201	    def _reusable(self, final_dir: str, content_digest: str) -> bool:
   202	        try:
   203	            with open(os.path.join(final_dir, MANIFEST_NAME), encoding="utf-8") as fh:
   204	                existing = json.load(fh)
   205	            if existing.get("content_digest") != content_digest:
   206	                return False
   207	            return self.verify(final_dir, strict=False).get("ok") is True
   208	        except (OSError, ValueError):
   209	            return False
   210	
   211	    # ------------------------------------------------------------------ #
   212	    # 对账：manifest 校验
   213	    # ------------------------------------------------------------------ #
   214	    def verify(self, release_dir: str, strict: bool = True) -> Dict[str, Any]:
   215	        """manifest 对账：缺件/多件/哈希漂移任一非空即失败（D4）。
   216	
   217	        strict=True（默认）失败抛 VerifyError（携带完整报告）；
   218	        strict=False 返回含 ``ok`` 布尔的报告，供调用方自行裁决。
   219	        """
   220	        release = os.path.abspath(release_dir)
   221	        manifest_path = os.path.join(release, MANIFEST_NAME)
   222	        if not os.path.isfile(manifest_path):
   223	            report = {
   224	                "ok": False, "release_dir": release, "release_id": None,
   225	                "missing": [MANIFEST_NAME], "extra": [], "drifted": [], "checked": 0,
   226	            }
   227	            if strict:
   228	                raise VerifyError(report)
   229	            return report
   230	
   231	        with open(manifest_path, encoding="utf-8") as fh:
   232	            manifest = json.load(fh)
   233	        expected = {e["path"]: e["sha256"] for e in manifest.get("files", [])}
   234	        actual = set(_collect_files(release)) - {MANIFEST_NAME}  # manifest 自身不在清单内
   235	        expected_set = set(expected)
   236	
   237	        missing = sorted(expected_set - actual)
   238	        extra = sorted(actual - expected_set)
   239	        drifted = sorted(
   240	            p for p in expected_set & actual
   241	            if _sha256_file(os.path.join(release, p)) != expected[p]
   242	        )
   243	        ok = not (missing or extra or drifted)
   244	        report = {
   245	            "ok": ok,
   246	            "release_dir": release,
   247	            "release_id": manifest.get("release_id"),
   248	            "missing": missing,
   249	            "extra": extra,
   250	            "drifted": drifted,
   251	            "checked": len(expected_set & actual),
   252	        }
   253	        if strict and not ok:
   254	            raise VerifyError(report)
   255	        return report
   256	
   257	    # ------------------------------------------------------------------ #
   258	    # 切换：原子 symlink
   259	    # ------------------------------------------------------------------ #
   260	    def switch(self, current_symlink: str, target: str) -> Dict[str, Any]:
   261	        """原子切换 current symlink -> target（D3：临时链接 + os.replace）。"""
   262	        link = os.path.abspath(current_symlink)
   263	        target_abs = os.path.abspath(target)
   264	        if not os.path.isdir(target_abs):
   265	            raise SwitchError(f"switch target not found: {target_abs}")
   266	
   267	        link_dir = os.path.dirname(link) or "."
   268	        os.makedirs(link_dir, exist_ok=True)
   269	        if os.path.lexists(link) and not os.path.islink(link):
   270	            raise SwitchError(f"refuse to replace non-symlink path: {link}")
   271	
   272	        previous = os.readlink(link) if os.path.islink(link) else None
   273	        link_value = os.path.relpath(target_abs, link_dir)  # 相对链接，目录整体迁移不失效
   274	        tmp_link = os.path.join(
   275	            link_dir, f".{os.path.basename(link)}.switch-{os.getpid()}")
   276	        if os.path.lexists(tmp_link):
   277	            os.remove(tmp_link)
   278	        os.symlink(link_value, tmp_link)
   279	        try:
   280	            os.replace(tmp_link, link)  # D3：rename 原子性，瞬时生效
   281	        except OSError as exc:
   282	            if os.path.lexists(tmp_link):
   283	                os.remove(tmp_link)
   284	            raise SwitchError(f"atomic symlink switch failed: {link} -> {target_abs}: {exc}") from exc
   285	
   286	        return {
   287	            "current_symlink": link,
   288	            "previous": previous,
   289	            "previous_abs": (
   290	                os.path.normpath(os.path.join(link_dir, previous)) if previous else None),
   291	            "target": target_abs,
   292	            "link_value": link_value,
   293	        }
   294	
   295	    def rollback(self, current: str, previous: str) -> Dict[str, Any]:
   296	        """切回兼容版：先对 previous release 做 manifest 完好性对账，再原子切回。
   297	
   298	        previous 已损坏（缺件/漂移）时拒绝回切并抛错——绝不把流量切到坏包上。
   299	        """
   300	        prev = os.path.abspath(previous)
   301	        if not os.path.isdir(prev):
   302	            raise SwitchError(f"rollback target missing: {prev}")
   303	        verify_report = self.verify(prev)
   304	        result = self.switch(current, prev)
   305	        result.update({"rolled_back": True, "verify": verify_report})
   306	        return result
   307	
   308	    # ------------------------------------------------------------------ #
   309	    # 编排：build -> verify -> switch -> 安装自检
   310	    # ------------------------------------------------------------------ #
   311	    def deploy(self, source_dir: str) -> Dict[str, Any]:
   312	        """完整部署：构建 -> 对账 -> 原子切换 -> 安装自检。
   313	
   314	        D2：自检失败 = 部署失败——自动回滚上一版后抛 DeployError。
   315	        P0-7 修：首次部署无上一版可回滚时，切回空/删除 current link（不留在失败版上）。
   316	        """
   317	        build_result = self.build(source_dir)
   318	        verify_report = self.verify(build_result["release_dir"])  # 切换前对账
   319	
   320	        # P0-7 修：切换前记录是否存在 current link（首次部署判定）
