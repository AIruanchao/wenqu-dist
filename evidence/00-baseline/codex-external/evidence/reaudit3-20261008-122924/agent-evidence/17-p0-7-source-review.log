    23	touch "$PREFIX/lib/wenqu_core/__init__.py"
    24	[ -f "$SRC"/wenqu_core/__init__.py ] && cp "$SRC"/wenqu_core/__init__.py "$PREFIX/lib/wenqu_core/"
    25	
    26	for f in "$SRC"/schemas/*.json; do
    27	  [ -f "$f" ] && cp "$f" "$PREFIX/schemas/"
    28	done
    29	
    30	for ext in html css js py; do
    31	  [ -f "$SRC/dashboard/index.$ext" ] && cp "$SRC/dashboard/index.$ext" "$PREFIX/dashboard/"
    32	done
    33	[ -f "$SRC/dashboard/app.$ext" ] || true
    34	for f in "$SRC"/dashboard/*.html "$SRC"/dashboard/*.css "$SRC"/dashboard/*.js "$SRC"/dashboard/*.py; do
    35	  [ -f "$f" ] && cp "$f" "$PREFIX/dashboard/"
    36	done
    37	
    38	# P0-1 验证：新核心安装后必须可导入，否则安装失败
    39	if ! PYTHONPATH="$PREFIX/lib" python3 -c "from wenqu_core.runner import TrustedRunner" 2>/dev/null; then
    40	  echo "✗ 安装自检失败：wenqu_core 不可导入——安装中止" >&2
    41	  exit 1
    42	fi
    43	echo "✓ wenqu_core 安装验证通过（TrustedRunner 可导入）"
    44	
    45	cp -R "$SRC"/bin/. "$PREFIX/bin/"
    46	cp -R "$SRC"/sentinels/. "$PREFIX/sentinels/" 2>/dev/null || true
    47	cp -R "$SRC"/daemons/. "$PREFIX/daemons/" 2>/dev/null || true
    48	# P0 containment：安装面始终收敛为不可启动的审计 stub。
    49	printf '%s\n' 'printf '\''%s\n'\'' '\''auto-merge permanently disabled per P0 containment'\'' >&2; exit 1' > "$PREFIX/daemons/auto-merge.sh"
    50	cp -R "$SRC"/db/. "$PREFIX/db/" 2>/dev/null || true
    51	cp -R "$SRC"/ci/. "$PREFIX/ci/" 2>/dev/null || true
    52	cp -R "$SRC"/templates/. "$PREFIX/templates/" 2>/dev/null || true
    53	cp -R "$SRC"/specs/. "$PREFIX/specs/" 2>/dev/null || true
    54	[ -f "$SRC/config/wenqu.env.example" ] && cp "$SRC/config/wenqu.env.example" "$PREFIX/env.example"
    55	chmod +x "$PREFIX"/bin/* "$PREFIX"/sentinels/* "$PREFIX"/daemons/* 2>/dev/null || true
    56	
    57	# 3. PATH 注入（幂等）
    58	case ":$PATH:" in
    59	  *":$PREFIX/bin:"*) : ;;
    60	  *) SHELL_RC="$HOME/.zshrc"; [ -n "${BASH_VERSION:-}" ] && SHELL_RC="$HOME/.bashrc"
    61	     echo "export PATH=\"$PREFIX/bin:\$PATH\"" >> "$SHELL_RC"
    62	     echo "✓ PATH 已写入 ${SHELL_RC}（新开终端生效）" ;;
    63	esac
    64	
    65	# 4. 首个配置（幂等）
