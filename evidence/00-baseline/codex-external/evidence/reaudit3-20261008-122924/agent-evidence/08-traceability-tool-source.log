   312	def cross_check_plan(plan_path, catalog):
   313	    """可选：解析方案 §20 表格提取 ID 集合，与冻结目录做集合等式校验（§25.1 要求）。"""
   314	    try:
   315	        with open(plan_path, encoding="utf-8") as f:
   316	            text = f.read()
   317	    except OSError as e:
   318	        return {"ok": False, "error": f"读取方案失败: {e}", "plan_ids": None}
   319	    body = text
   320	    # 只取 §20～§21 之间的正文，避免 §25 表格里的范围写法（GATE-01～12）污染集合
   321	    m20 = re.search(r"^# 20\.", body, re.M)
   322	    m21 = re.search(r"^# 21\.", body, re.M)
   323	    if m20 and m21:
   324	        body = body[m20.start():m21.start()]
   325	    ids = set(re.findall(r"\b([A-Z]{2,5}-\d{2})\b", body))
   326	    plan_ids = {i for i in ids if not re.match(r"^(FND|W\d)", i)}
   327	    frozen = set(catalog)
   328	    return {
   329	        "ok": plan_ids == frozen,
   330	        "plan_only": sorted(plan_ids - frozen),
   331	        "frozen_only": sorted(frozen - plan_ids),
   332	        "plan_ids_count": len(plan_ids),
   333	        "frozen_count": len(frozen),
   334	    }
   335	
