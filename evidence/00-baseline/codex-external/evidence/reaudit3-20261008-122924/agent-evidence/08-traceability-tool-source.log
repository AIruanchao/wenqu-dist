   471	def main():
   472	    ap = argparse.ArgumentParser(description="§20 131 验收 ID 追踪矩阵生成器")
   473	    ap.add_argument("--json", default=os.path.join(EVIDENCE_ROOT, "traceability-matrix.json"),
   474	                    help="输出 JSON 路径（默认 evidence/traceability-matrix.json）")
   475	    ap.add_argument("--plan",
   476	                    default=os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
   477	                                         "evidence", "00-baseline", "codex-external", "方案.md"),
   478	                    help="方案文件路径（默认仓内快照 evidence/00-baseline/codex-external/方案.md；存在则做 ID 集合交叉校验）")
   479	    ap.add_argument("--check", action="store_true",
   480	                    help="目录完整性/集合校验失败时 exit 2")
   481	    args = ap.parse_args()
   482	
   483	    catalog, problems = build_catalog()
   484	    integrity_ok = not problems
   485	
   486	    plan_check = None
   487	    if args.plan and os.path.isfile(args.plan):
   488	        plan_check = cross_check_plan(args.plan, catalog)
   489	        if not plan_check.get("ok", False):
   490	            problems.append(f"方案交叉校验不一致: {plan_check.get('plan_only')}/{plan_check.get('frozen_only')}")
   491	
   492	    direct, scanned = collect_test_matches(catalog)
   493	    evidence_map = collect_evidence_matches(catalog)
   494	
   495	    matrix = {}
   496	    n_impl = n_proxy = 0
   497	    for tid in sorted(catalog):
   498	        meta = catalog[tid]
   499	        entry = {
   500	            "implemented": False,
   501	            "test_file": "",
   502	            "evidence_path": "",
   503	            "match_type": "missing",
   504	            "test_function": "",
   505	            "section": meta["section"],
   506	            "injection": meta["injection"],
   507	            "expectation": meta["expectation"],
   508	            "req": meta["req"],
   509	            "ac": meta["ac"],
   510	            "work_packages": meta["work_packages"],
   511	            "evidence_class": meta["evidence_class"],
   512	        }
   513	        if tid in direct:
   514	            entry.update(implemented=True, match_type="dedicated",
   515	                         test_file=direct[tid]["test_file"],
   516	                         test_function=direct[tid]["test_function"],
   517	                         line=direct[tid]["line"])
   518	            n_impl += 1
   519	        elif tid in PROXY_ALIASES:
   520	            pa = PROXY_ALIASES[tid]
   521	            entry.update(implemented=False, match_type="proxy_partial",
   522	                         test_file=pa["test_file"],
   523	                         test_function=pa["test_function"],
   524	                         proxy_note=pa["note"])
   525	            n_proxy += 1
   526	        if tid in evidence_map:
   527	            entry["evidence_path"] = evidence_map[tid]
   528	        matrix[tid] = entry
   529	
   530	    total = len(matrix)
   531	    missing = total - n_impl - n_proxy
   532	    by_prefix = {}
   533	    for tid, e in matrix.items():
   534	        pfx = tid.split("-")[0]
   535	        st = by_prefix.setdefault(pfx, {"total": 0, "dedicated": 0, "proxy": 0})
   536	        st["total"] += 1
   537	        if e["match_type"] == "dedicated":
   538	            st["dedicated"] += 1
   539	        elif e["match_type"] == "proxy_partial":
   540	            st["proxy"] += 1
   541	
   542	    now = datetime.now(timezone(timedelta(hours=8)))
   543	    report = {
   544	        "meta": {
   545	            "tool": "tools/ac_traceability.py",
   546	            "generated_at": now.isoformat(timespec="seconds"),
   547	            "repo_root": REPO_ROOT,
   548	            "repo_head": git_head(),
   549	            "plan_source": "/private/tmp/codex-test/方案.md",
   550	            "plan_sha256": PLAN_SHA256,
   551	            "catalog_integrity": "OK" if integrity_ok else "FAIL",
   552	            "catalog_problems": problems,
   553	            "plan_cross_check": plan_check,
   554	            "scanned_files": scanned,
   555	            "scan_roots": SCAN_ROOTS,
   556	            "proxy_policy": "代理测试不冒充专属验收：implemented 仅在存在以该 ID 命名/标注的测试函数或用例时为 true",
   557	        },
   558	        "stats": {
   559	            "total_ids": total,
   560	            "dedicated_implemented": n_impl,
   561	            "proxy_partial": n_proxy,
   562	            "missing": missing,
   563	            "dedicated_coverage_pct": round(100.0 * n_impl / total, 2) if total else 0.0,
   564	            "dedicated_plus_proxy_pct": round(100.0 * (n_impl + n_proxy) / total, 2) if total else 0.0,
   565	            "by_prefix": by_prefix,
   566	        },
   567	        "matrix": matrix,
   568	    }
   569	
   570	    out_path = args.json
   571	    os.makedirs(os.path.dirname(out_path) or ".", exist_ok=True)
   572	    with open(out_path, "w", encoding="utf-8") as f:
   573	        json.dump(report, f, ensure_ascii=False, indent=2, sort_keys=False)
   574	        f.write("\n")
   575	
   576	    # ---------------- 覆盖率统计输出 ----------------
   577	    print("=" * 64)
   578	    print("Codex 方案 §20 验收 ID 追踪矩阵（P0-10）")
   579	    print(f"生成时间: {report['meta']['generated_at']}  HEAD: {report['meta']['repo_head'] or 'N/A'}")
   580	    print(f"目录完整性: {report['meta']['catalog_integrity']}  "
   581	          f"(冻结 {total} ID，期望 {EXPECTED_TOTAL})")
   582	    if plan_check is not None:
   583	        print(f"方案交叉校验(§25.1 集合等式): {'PASS' if plan_check.get('ok') else 'FAIL'}"
   584	              f"  方案侧 {plan_check.get('plan_ids_count')} vs 冻结 {plan_check.get('frozen_count')}")
   585	        if not plan_check.get("ok"):
   586	            print(f"  仅方案有: {plan_check.get('plan_only')}  仅冻结有: {plan_check.get('frozen_only')}")
   587	    elif args.plan and not os.path.isfile(args.plan):
   588	        print(f"方案交叉校验: SKIP（{args.plan} 不存在，使用内置冻结目录 sha256 锚定）")
   589	    print("-" * 64)
   590	    print(f"总计测试 ID        : {total}")
   591	    print(f"专属已实现          : {n_impl}  ({report['stats']['dedicated_coverage_pct']}%)")
   592	    print(f"代理部分覆盖(不计实现): {n_proxy}")
   593	    print(f"缺失                : {missing}")
   594	    print(f"专属+代理覆盖参考   : {report['stats']['dedicated_plus_proxy_pct']}%")
   595	    print("-" * 64)
   596	    print(f"{'前缀':<8}{'总数':>4}{'专属':>6}{'代理':>6}")
   597	    for pfx in sorted(by_prefix, key=lambda x: (-by_prefix[x]["total"], x)):
   598	        st = by_prefix[pfx]
   599	        print(f"{pfx:<8}{st['total']:>4}{st['dedicated']:>6}{st['proxy']:>6}")
   600	    print("-" * 64)
   601	    if n_impl:
   602	        print("已实现 ID:", ", ".join(t for t in sorted(matrix) if matrix[t]["implemented"]))
   603	    if n_proxy:
   604	        print("代理覆盖 ID:", ", ".join(t for t in sorted(matrix)
   605	                                        if matrix[t]["match_type"] == "proxy_partial"))
   606	    print(f"输出: {os.path.relpath(out_path, REPO_ROOT)}  (扫描 {len(scanned)} 个测试文件)")
   607	    print("=" * 64)
   608	
   609	    if args.check and problems:
   610	        for p in problems:
   611	            print(f"INTEGRITY-FAIL: {p}", file=sys.stderr)
   612	        sys.exit(2)
   613	    sys.exit(0)
