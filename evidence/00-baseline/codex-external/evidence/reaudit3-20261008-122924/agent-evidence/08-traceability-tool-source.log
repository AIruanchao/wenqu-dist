   396	def collect_test_matches(catalog):
   397	    """返回 {test_id: {"test_file":..., "test_function":..., "line":...}}（专属命中）。"""
   398	    # 归一化形态：GATE-01 / GATE_01（函数名下划线写法）
   399	    id_forms = {}
   400	    for tid in catalog:
   401	        prefix, num = tid.split("-")
   402	        id_forms[tid] = [f"{prefix}-{num}", f"{prefix}_{num}", f"test_{prefix}_{num}"]
   403	    matches = {}
   404	    scanned = []
   405	    all_forms = sorted({f for forms in id_forms.values() for f in forms})
   406	    for path in iter_test_files():
   407	        rel = os.path.relpath(path, REPO_ROOT)
   408	        scanned.append(rel)
   409	        try:
   410	            with open(path, encoding="utf-8", errors="ignore") as f:
   411	                content = f.read()
   412	        except OSError:
   413	            continue
   414	        present = [f for f in all_forms if f in content]
   415	        if not present:
   416	            continue
   417	        if path.endswith(".py"):
   418	            hits, err = scan_python(path, present)
   419	        else:
   420	            hits, err = scan_shell(path, present)
   421	        if err:
   422	            continue
   423	        # form -> test_id 反查
   424	        for tid, forms in id_forms.items():
   425	            for form in forms:
   426	                if form in hits:
   427	                    owner, line = hits[form][0]
   428	                    matches.setdefault(tid, {
   429	                        "test_file": rel, "test_function": owner,
   430	                        "line": line, "match_kind": "dedicated",
   431	                    })
   432	                    break
   433	    return matches, scanned
   434	
   435	
   436	def collect_evidence_matches(catalog):
   437	    """evidence/ 下含 ID 的非 README 工件（排除本工具输出）。"""
   438	    matches = {}
   439	    if not os.path.isdir(EVIDENCE_ROOT):
   440	        return matches
   441	    for dirpath, dirnames, filenames in os.walk(EVIDENCE_ROOT):
   442	        for fn in filenames:
   443	            if fn == "README.md" or fn in SELF_OUTPUT_NAMES or fn.endswith(".sha256"):
   444	                continue
   445	            p = os.path.join(dirpath, fn)
   446	            rel = os.path.relpath(p, REPO_ROOT)
   447	            try:
   448	                if os.path.getsize(p) > 2_000_000:
   449	                    continue
   450	                with open(p, encoding="utf-8", errors="ignore") as f:
   451	                    content = f.read()
   452	            except OSError:
   453	                continue
   454	            for tid in catalog:
   455	                if tid in content:
   456	                    matches.setdefault(tid, rel)
   457	    return matches
