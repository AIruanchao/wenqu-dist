   337	EXCLUDE_DIRS = {"__pycache__", ".pytest_cache", ".git", "node_modules"}
   338	
   339	
   340	def iter_test_files():
   341	    for root_rel in SCAN_ROOTS:
   342	        root = os.path.join(REPO_ROOT, root_rel)
   343	        if not os.path.isdir(root):
   344	            continue
   345	        for dirpath, dirnames, filenames in os.walk(root):
   346	            dirnames[:] = [d for d in dirnames if d not in EXCLUDE_DIRS]
   347	            for fn in filenames:
   348	                if fn.endswith((".py", ".sh")):
   349	                    yield os.path.join(dirpath, fn)
   350	
   351	
   352	TESTISH_NAME = re.compile(r"(^test_|_self_test$|^_?selftest|self_test)", re.I)
   353	
   354	
   355	def scan_python(path, wanted_forms):
   356	    """在 .py 中定位 ID 出现点，归属到 test 型函数才算 implemented。"""
   357	    try:
   358	        with open(path, encoding="utf-8") as f:
   359	            src = f.read()
   360	        tree = ast.parse(src)
   361	    except (OSError, SyntaxError, UnicodeDecodeError) as e:
   362	        return {}, f"parse 失败: {e}"
   363	    funcs = []  # (name, lineno, end_lineno)
   364	    for node in ast.walk(tree):
   365	        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
   366	            funcs.append((node.name, node.lineno, node.end_lineno or node.lineno))
   367	    lines = src.splitlines()
   368	    hits = {}
   369	    for form in wanted_forms:
   370	        for i, line in enumerate(lines, start=1):
   371	            if form in line:
   372	                owner = None
   373	                for name, lo, hi in funcs:
   374	                    if lo <= i <= hi:
   375	                        owner = name
   376	                        break
   377	                if owner is not None and TESTISH_NAME.search(owner):
   378	                    hits.setdefault(form, []).append((owner, i))
   379	    return hits, None
   380	
   381	
   382	def scan_shell(path, wanted_forms):
   383	    try:
   384	        with open(path, encoding="utf-8") as f:
   385	            lines = f.read().splitlines()
   386	    except (OSError, UnicodeDecodeError) as e:
   387	        return {}, f"read 失败: {e}"
   388	    hits = {}
   389	    for form in wanted_forms:
   390	        for i, line in enumerate(lines, start=1):
   391	            if form in line and not line.strip().startswith("#"):
   392	                hits.setdefault(form, []).append(("(script-case)", i))
   393	    return hits, None
   394	
