   460	def git_head():
   461	    try:
   462	        out = subprocess.run(["git", "rev-parse", "HEAD"], cwd=REPO_ROOT,
   463	                             capture_output=True, text=True, timeout=10)
   464	        if out.returncode == 0:
   465	            return out.stdout.strip()
   466	    except Exception:
   467	        pass
   468	    return None
