def cmd_close(args):
    # fork8 F4：close 是「锁外读-判定/锁内写」的第四个写者——并发 close 对陈旧 OPEN
    # 双双通过校验=状态机横跳入账（fork6 批自述共同根因未修净）；全程持锁同 ingest/sweep
    home = home_of(args)
    with _ledger_lock(home):
        view = resolve(load_entries(home))
        if args.id not in view:
            die(f"无此 id：{args.id}")
        _, cur, _ = view[args.id]
        to = args.to.upper()
        if to not in STATUSES:
            die(f"目标状态非法：{to}")
        if cur == to:
            die(f"现态已是 {to}，拒绝空转移")
        if not getattr(args, "allow_any", False) and to not in ALLOWED_TRANSITIONS.get(cur, set()):
            die(f"非法转移 {cur} → {to}（状态机 v0.2#14；确需请 --allow-any 并在 note 说明）")
        _append_unlocked(home, {"kind": "transition", "id": args.id, "from": cur, "to": to,
                                "note": args.note, "ts": now()})
    print(f"OK close：{args.id} {cur} → {to}（append-only 转移已入账）")


def cmd_verify(args):
    home = home_of(args)
    if not (home / STATE).exists():
        die("未 init——无可验证范围")
    entries = load_entries(home)
    schema_errs = [validate_finding(e, f"id={e.get('id')}") for e in entries
                   if e.get("kind", "finding") == "finding"]
    schema_errs += [validate_transition(e, f"转移 id={e.get('id')}") for e in entries
                    if e.get("kind") == "transition"]
    schema_errs = [s for s in schema_errs if s]
    view = resolve(entries)
    opens = [fid for fid, (_, st, _) in view.items() if st == "OPEN"]
    drift = ""
    if args.check_scope:
        st = json.loads((home / STATE).read_text(encoding="utf-8"))
        cur = _scope_files(Path(st["root"]), st.get("exts") or SRC_EXTS, st.get("skip_dirs") or ())  # fork8 F6：init 冻结的 skip_dirs 必须参与重算，否则未动仓假漂移红
        drift = ("" if _scope_hash(cur) == st["scope_hash"]
                 else f"范围漂移：冻结 {st['files']} 文件，现 {len(cur)} 文件")
    conv_txt, converged = "", True
    if getattr(args, "convergence", 0):
        # fork2（2026-10-02 加固，BSF-20261002-38 修复）：零/不足轮次不得判 Converged——
        # 原实现 converged 初值 True，空账本直接过 exit code 门=空转假绿；并补轮次连续性检查
        # fork6（#4，加固六）：轮次证据限定 run 行∪带 round 的 finding/transition 产物行——
        # 原集合不过滤 kind，charter 行同权参与（charter 只打印提示词零探测，两条命令
        # 即可铸连续轮号伪造 Converged，实测）；AI 审轮（ingest --round 产物）保留资格
        # fork19-CX16（Codex 四审#1）：convergence 绑仓——run 须带 root 且匹配 state.root
        _v_st = json.loads((home / STATE).read_text(encoding="utf-8")) if (home / STATE).exists() else {}
        _v_root = _v_st.get("root", "")
        all_rounds = sorted({e.get("round") for e in entries
                             if isinstance(e.get("round"), int)
                             and e.get("kind") in ("run", "finding", "transition")
                             and (e.get("kind") != "run" or str(e.get("root", _v_root)) == _v_root)})
        if len(all_rounds) < args.convergence:
            converged = False
            conv_txt = f"；收敛环=证据不足（已标 {len(all_rounds)}/{args.convergence} 轮，拒绝 Converged）"
        else:
            top = all_rounds[-args.convergence:]
            if top != list(range(top[0], top[0] + args.convergence)):
                converged = False
                conv_txt = f"；收敛环=轮次不连续（{top}）"
            else:
                top_set = set(top)
                converged = not [e for e in entries if e.get("kind", "finding") == "finding"
                                 and e.get("round") in top_set]
                conv_txt = f"；收敛环={'Converged' if converged else '未收敛'}（近 {args.convergence} 轮零新发现）"
    ok = (not schema_errs and len(opens) <= args.allow_open
          and (not drift or args.allow_drift) and converged)
    print(f"{'OK' if ok else 'FAIL'} verify：schema {'净' if not schema_errs else '损'}；"
          f"OPEN {len(opens)}/{args.allow_open} 限额；总 {len(view)} 条"
          + conv_txt
          + (f"；{drift}" if drift else "；范围=冻结态" if args.check_scope else ""))
    for fid in opens[:10]:
        print(f"  OPEN：{fid}")
    for s in schema_errs[:5]:
        print(f"  schema：{s}", file=sys.stderr)
    sys.exit(0 if ok else 1)


def cmd_sweep(args):
    """血统件B（v0.3）：auto-close——station 最近一次 run 为 PASS 时，其 OPEN 的 AUTO 发现转 FIXED。"""
    home = home_of(args)
    # fork6（#6，加固六）：重读-判定-写入全程持锁+单事务批写——原锁外构建 view 逐条 append，
    # 窗口内发现被 close 后仍按陈旧 OPEN 快照落 OPEN→FIXED（实测复活已关闭发现=状态机
    # 明令禁止的 CLOSED→FIXED 横跳）；且逐条 append 中途失败留半批
    # fork19-CX8（Codex#8）：sweep 绑定目标仓——原同一 home 对缺陷仓 init/run 得 OPEN，
    # 再对干净仓运行同名站得 PASS 即可洗白缺陷仓 finding（跨仓 sweep 漏洞）
    _st = json.loads((home / STATE).read_text(encoding="utf-8")) if (home / STATE).exists() else {}
    _sweep_root = str(_st.get("root", ""))
    with _ledger_lock(home):
        entries = load_entries(home)
        runs = [e for e in entries if e.get("kind") == "run" and e.get("station") == args.station]
        if not runs or runs[-1].get("exit") != 0:
            die(f"站位 {args.station} 无 PASS 的 run 记录，拒绝 sweep（防误关）")
        # fork19-CX8：PASS run 必须绑同仓——最近 PASS 的 root 须匹配 state.root
        _pass_root = str(runs[-1].get("root", _sweep_root))
        if _pass_root != _sweep_root:
            die(f"站位 {args.station} 最近 PASS 在 {_pass_root}（≠本仓 {_sweep_root}）——拒绝跨仓 sweep（CX8）", 2)
        if "root" not in runs[-1]:
            die(f"站位 {args.station} 最近 PASS run 无 root（fork19 前旧格式）——拒绝 sweep（CX10 fail-closed）", 2)
        view = resolve(entries)
        trans = []
        for fid, (f, st, _) in view.items():
            # fork5（BSF-20261002-40）：站名精确匹配用账本里已有的 provenance.station——
            # 原 `args.station in fid` 是 id 子串匹配，站名互为子串时误关别家发现
            # fork19-CX8：追加仓根匹配——provenance.root 必须与 state.root 一致
            if fid.startswith("AUTO-") and st == "OPEN" \
                    and f.get("provenance", {}).get("station") == args.station \
                    and str(f.get("provenance", {}).get("root", _sweep_root)) == _sweep_root:
                trans.append({"kind": "transition", "id": fid, "from": "OPEN", "to": "FIXED",
                              "note": "sweep：station %s 最近 run PASS" % args.station, "ts": now()})
        if trans:
            _append_unlocked(home, trans)
        closed = len(trans)
    print(f"OK sweep：{args.station} PASS → 自动关闭 {closed} 条 AUTO 发现")

