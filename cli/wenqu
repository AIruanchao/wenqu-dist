def cmd_repair(args):
    """v0.2#7：账本自愈——坏行/重复发现/孤儿转移 隔离进 .quarantine，正本只留健康行。"""
    home = home_of(args)
    led = home / LEDGER
    if not led.exists():
        die("无账本可修")
    # fork6（#2/#3/#8，加固六）：read→analyze→write 全程锁内（原 fork4 只把写搬进锁，
    # 读与分析仍基于锁外陈旧快照——窗口内他进程 append 的行被 os.replace 静默吞掉）；
    # surrogateescape 读保字节（GBK 等外部写入行隔离时原文不丢）；except 扩
    # AttributeError/TypeError（合法 JSON 非对象行原裸 crash 打死自愈命令本身）
    with _ledger_lock(home):
        lines = led.read_text(encoding="utf-8", errors="surrogateescape").split("\n")  # fork8 F1：物理行分割——splitlines 会按 U+2028/U+0085 拆行，json.dumps(ensure_ascii=False) 原样输出这些字符=合法输入落账即自毁
        good, quarantine, seen = [], [], set()
        for i, line in enumerate(lines, 1):
            if not line.strip():
                continue
            try:
                d = json.loads(line)
                if not isinstance(d, dict):
                    raise ValueError("第%d行：非对象 JSON %s" % (i, type(d).__name__))
                kind = d.get("kind", "finding")
                if kind == "finding":
                    err = validate_finding(d, "第%d行" % i)
                    if err:
                        raise ValueError(err)
                    if d["id"] in seen:
                        raise ValueError("第%d行：重复发现 id %s" % (i, d["id"]))
                    seen.add(d["id"])
                elif kind == "transition":
                    err = validate_transition(d, "第%d行" % i)
                    if err:
                        raise ValueError(err)
                elif kind in ("run", "charter", "note"):  # fork15：note（日志缺失回填）入白名单——BSF-39 同族教训
                    # fork4（2026-10-02 加固四，上游 BSF-20261002-39）：v0.3 行类白名单——
                    # repair 是 v0.2 件不认识 v0.3 的 run/charter 审计行，原实现当「未知 kind」
                    # 隔离（实测：一次 repair 清空全部 run 行+连锁废掉 sweep 的 PASS 依据）
                    pass
                else:
                    raise ValueError("第%d行：未知 kind %s" % (i, kind))
                good.append(line)
            except (json.JSONDecodeError, ValueError, AttributeError, TypeError) as e:
                quarantine.append(json.dumps({"bad_line_no": i, "reason": f"{type(e).__name__}: {e}", "raw": line}, ensure_ascii=False))
        ids = {json.loads(l)["id"] for l in good if json.loads(l).get("kind", "finding") == "finding"}
        final = []
        for l in good:
            d = json.loads(l)
            if d.get("kind") == "transition" and d["id"] not in ids:
                quarantine.append(json.dumps({"raw": l, "reason": "孤儿转移"}, ensure_ascii=False))
                continue
            final.append(l)
        tmp = home / (LEDGER + ".tmp")
        tmp.write_text(NJ(final), encoding="utf-8", errors="surrogateescape")
        os.replace(tmp, led)
    if quarantine:
        with (home / (LEDGER + ".quarantine")).open("a", encoding="utf-8", errors="surrogateescape") as q:
            q.write(NJ(quarantine))
    print("OK repair：保留 %d 行，隔离 %d 行 → %s.quarantine" % (len(final), len(quarantine), LEDGER))
    sys.exit(0)

def cmd_selftest(args):
    """端到端自证：临时仓 init→run(伪站位经 monkey 注入)→ingest 合法/拒绝→close→verify。"""
    with tempfile.TemporaryDirectory() as td:
        repo = Path(td) / "repo"
        repo.mkdir()
        (repo / "a.py").write_text("x = 1\n", encoding="utf-8")
        home = Path(td) / "wh"
        sys.argv = ["wenqu"]
        fake = {"fake": {"cmd": [sys.executable, "-c", "print('ok')"], "sev": "LOW"},
                "fakebad": {"cmd": [sys.executable, "-c", "import sys;sys.exit(1)"], "sev": "HIGH"}}  # fork11：rc 契约=1 命中/≥2 环境错误
        saved = dict(STATIONS)
        STATIONS.update(fake)
        try:
            ns = lambda **kw: argparse.Namespace(path=str(repo), home=str(home), partial=False, round=0,
                                                 check_scope=False, allow_drift=False, **kw)
            run = lambda fn: _exit_of(fn)  # 统一捕获 CLI 契约退出码
            assert run(lambda: cmd_init(ns())) == 0, "init 应 0 退出"
            assert (home / STATE).exists(), "init 未落 state"
            assert run(lambda: cmd_run(ns(station="fake"))) == 0, "PASS 站应 0 退出"
            assert run(lambda: cmd_run(ns(station="fakebad"))) == 1, "FAIL 站应 1 退出"
            bad = Path(td) / "bad.jsonl"
            bad.write_text('{"id":"X-1","sev":"HIGH","status":"OPEN"}\n{"id":"X-1","sev":"HIGH","status":"OPEN"}\n'
                           '{"id":"X-2","sev":"致命","status":"OPEN"}\n', encoding="utf-8")
            assert run(lambda: cmd_ingest(ns(file=str(bad)))) == 2, "脏数据应 2 退出"
            out0 = _capture(lambda: run(lambda: cmd_findings(ns(sev=None, status=None))))
            assert "X-1" not in out0, "原子拒绝后账本不得含半批件"
            good = Path(td) / "g.jsonl"
            good.write_text('{"id":"X-9","sev":"LOW","status":"OPEN","title":"样例"}\n', encoding="utf-8")
            assert run(lambda: cmd_ingest(ns(file=str(good)))) == 0, "净数据应 0 退出"
            out = _capture(lambda: run(lambda: cmd_findings(ns(sev=None, status=None))))
            assert "X-9" in out and "AUTO-" in out, "findings 未列出 X-9 与 AUTO"
            assert run(lambda: cmd_close(ns(id="X-9", to="CLOSED", note="自测关闭"))) == 0
            assert run(lambda: cmd_verify(ns(allow_open=0))) == 1, "AUTO OPEN 存在时 verify 应 FAIL"
            opener = [f for f, (_, s, _) in resolve(load_entries(home)).items() if s == "OPEN"][0]
            assert run(lambda: cmd_close(ns(id=opener, to="FIXED", note="自测修复"))) == 0
            assert run(lambda: cmd_verify(ns(allow_open=0))) == 0, "清零后 verify 应 PASS"
            # fork6 断言（#12a）：selftest 补 fork2-5 防线零覆盖面——
            # ① repair 保 run 审计行（BSF-39）②charter 铸轮不构成轮次证据（#4）
            assert run(lambda: cmd_run(ns(station="fake"))) == 0
            assert run(lambda: cmd_repair(ns())) == 0
            assert any(e.get("kind") == "run" for e in load_entries(home)), "repair 后 run 审计行必须存活"
            append(home, {"kind": "charter", "station": "fake", "round": 9, "ts": now()})
            assert run(lambda: cmd_verify(ns(allow_open=0, convergence=2))) == 1, "charter 铸轮应被拒绝（证据不足）"
        finally:
            STATIONS.clear(); STATIONS.update(saved)
    print("OK selftest：契约全过（init/run 双态/ingest 拒脏/账本 append-only/close/verify 门+fork6 两断言）")


def _exit_of(fn) -> int:
    """执行并捕获 CLI 契约退出码（0/1/2 都是正常返回值）。"""
    try:
        fn()
        return 0
    except SystemExit as e:
        return int(e.code or 0)


def _capture(fn) -> str:
    import io as _io
    import contextlib
    buf = _io.StringIO()
    try:
        with contextlib.redirect_stdout(buf):
            fn()
    except SystemExit:
        pass
    return buf.getvalue()


def main(argv=None):
    ap = argparse.ArgumentParser(prog="wenqu", description="问渠缺陷工程轨道 CLI（F7 MVP）")
    ap.add_argument("--home", help="账本目录（默认 <path>/.wenqu）")
    ap.add_argument("--version", action="version", version=f"wenqu {VERSION}")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("init", help="范围冻结（站0）")
    p.add_argument("--path", default=".")
    p.add_argument("--include", help="覆盖默认源码扩展名的逗号表（如 .py,.ts）")
    p.add_argument("--skip-dirs", default="", help="额外跳过目录（逗号表，v0.2#20）")
    p.add_argument("--force", action="store_true", help="范围变更且账本非空时强制重冻结（v0.2#11）")
    p.set_defaults(fn=cmd_init)
    p = sub.add_parser("run", help="跑确定性站位（AI 站走 charter+ingest）")
    p.add_argument("--path", default=".")
    p.add_argument("--round", type=int, default=0, help="标记本批轮次（fork2：落进 run 审计与 AUTO 发现，供 verify --convergence 判定）")
    # fork1（2026-10-02，BSF-20261002-37 修复）：去掉 choices=sorted(STATIONS)——
    # argparse 在解析期用内置表锁死站位，stations.json 自定义站位（域探测器插座）
    # 报 invalid choice 永远到不了 cmd_run 的动态合并；未知站位由 cmd_run 内 die 兜底
    p.add_argument("station")
    p.set_defaults(fn=cmd_run)
    p = sub.add_parser("ingest", help="外部发现/转移入账（schema 严格；默认原子全有或全无）")
    p.add_argument("--path", default=".")
    p.add_argument("--partial", action="store_true", help="恢复逐行部分接收（默认原子）")
    p.add_argument("--round", type=int, default=0, help="标记本批轮次（verify --convergence 用）")
    p.add_argument("--allow-any", action="store_true", help="转移跳过状态机校验（与 close 同名逃生门，fork6#5）")
    p.add_argument("file")
    p.set_defaults(fn=cmd_ingest)
    p = sub.add_parser("verify", help="三门收口（schema+OPEN 限额）→ exit 0/1")
    p.add_argument("--path", default=".")
    p.add_argument("--allow-open", type=int, default=0)
    p.add_argument("--check-scope", action="store_true", help="重算范围 hash 对照冻结态（漂移=FAIL）")
    p.add_argument("--allow-drift", action="store_true", help="漂移仅提示不计 FAIL（增量场景）")
    p.add_argument("--convergence", type=int, default=0, help="血统件B：要求近 N 轮零新发现（封存条件）")
    p.set_defaults(fn=cmd_verify)
    p = sub.add_parser("findings", help="账本查询（现态视图）")
    p.add_argument("--path", default=".")
    # fork19-CX4（Codex#4）：--sev/--status 枚举校验——原拼错如 OEPEN 静默空结果 exit 0=CI 假绿
    p.add_argument("--sev", choices=list(SEVS) + [s.lower() for s in SEVS], help="严重级过滤")
    p.add_argument("--status", choices=list(STATUSES) + [s.lower() for s in STATUSES], help="状态过滤")
    p.add_argument("--gate", action="store_true", help="任一匹配即 exit 1（CI 门禁，v0.2#15）")
    p.set_defaults(fn=cmd_findings)
    p = sub.add_parser("show", help="单条全览")
    p.add_argument("--path", default=".")
    p.add_argument("id")
    p.set_defaults(fn=cmd_show)
    p = sub.add_parser("close", help="状态转移（append-only）")
    p.add_argument("--path", default=".")
    p.add_argument("id"); p.add_argument("--to", default="CLOSED")
    p.add_argument("--allow-any", action="store_true", help="跳过状态机校验（v0.2#14）")
    p.add_argument("--note", required=True)
    p.set_defaults(fn=cmd_close)
    p = sub.add_parser("charter", help="血统件A：标准 charter 发射（章程附录 B）+审计入账")
    p.add_argument("--path", default=".")
    p.add_argument("name", help="站位/主题名")
    p.add_argument("--round", type=int, default=1)
    p.add_argument("--hetero", default="", help="异构端点名（空=同模型兜底标记）")
    p.set_defaults(fn=cmd_charter)
    p = sub.add_parser("sweep", help="血统件B：auto-close（station 最近 run PASS→其 AUTO 发现转 FIXED）")
    p.add_argument("--path", default=".")
    p.add_argument("station")
    p.set_defaults(fn=cmd_sweep)
    p = sub.add_parser("repair", help="账本自愈：坏行/重复/孤儿隔离（v0.2#7）")
    p.add_argument("--path", default=".")
    p.set_defaults(fn=cmd_repair)
    p = sub.add_parser("selftest", help="端到端自证（零依赖环境可用性检查）")
    p.set_defaults(fn=cmd_selftest, path=".")
    args = ap.parse_args(argv)
    # fork11（S5-F2）：--home 同构入口——读命令对不存在的 --home 凭空 mkdir 幽灵账本
    # →空账本→--gate 假绿（typo 一字之差门禁放行）；mkdir 权限只留给写命令（init/run/charter）
    _READ_CMDS = ("findings", "verify", "show", "sweep", "close", "repair", "ingest")
    # fork19-CX13（Codex 三审#1）：全部命令绑仓——CX9 只修了 run，verify/sweep/ingest
    # 仍可 --home A --path B 交叉操作=身份不一致（跨仓 convergence/ingest 投毒）
    # --path 默认 "." 时跳过（ingest 等不显式传 --path 的调用面）；仅显式传了不同 --path 才拦
    _explicit_path = getattr(args, "path", None)
    if _explicit_path and _explicit_path != "." and getattr(args, "cmd", "") in ("run", "ingest", "verify", "sweep", "close"):
        _h_for_check = Path(getattr(args, "home", None) or (Path(_explicit_path) / ".wenqu"))
        _st_f = _h_for_check / STATE
        if _st_f.exists():
            _st_r = json.loads(_st_f.read_text(encoding="utf-8")).get("root", "")
            if _st_r and str(Path(_explicit_path).resolve()) != _st_r:
                die(f"--path 与 init 冻结仓不一致：{_explicit_path} ≠ {_st_r}（CX13 全命令绑仓）")
    if getattr(args, "cmd", "") in _READ_CMDS:
        # fork12（S6-4）：缺省 home 同构入口——未 init 仓的 findings --gate 原凭空 mkdir
        # .wenqu→空账本→exit 0 假绿+写入仓（CI 新 clone 忘 init=门禁永久假绿）
        _h = getattr(args, "home", None) or str(Path(getattr(args, "path", ".")).resolve() / ".wenqu")
        if not Path(_h).is_dir():
            die(f"账本目录不存在：{_h}（不凭空造目录；请先 wenqu init 或修正 --home/--path）", 2)
    if getattr(args, "path", None) and not Path(args.path).resolve().is_dir():
        die(f"--path 不存在：{args.path}（fork9 S3-四：原读命令 typo 会凭空 mkdir 幽灵仓→空账本→--gate 假绿）")
    # fork3（2026-10-02 加固二）：轮次/收敛参数值域守卫——负 round 落账会污染
    # verify --convergence 的轮次集合（负轮号可参与甚至伪造连续性）；N<1 的
    # --convergence 语义非法（0=falsy 静默跳过、负数切片行为未定义）。0=不标轮次，合法。
    if getattr(args, "round", 0) < 0:
        die("--round 须为 ≥1 的整数（0=不标记轮次）")
    if getattr(args, "cmd", "") == "charter" and getattr(args, "round", 1) < 1:
        die("charter 轮次须 ≥1（fork9 S3-六：0 穿透产出自相矛盾文案+错配 LADDER_CAP）")
    if getattr(args, "convergence", 0) and args.convergence < 1:
        die("--convergence 须为 ≥1 的整数")
    if getattr(args, "include", None):
        args.include_exts = tuple(
            t if t.startswith(".") else "." + t for t in (x.strip() for x in args.include.split(",")))
    args.fn(args)


if __name__ == "__main__":
    main()
