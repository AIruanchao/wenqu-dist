def NJ(rows):
    return "".join(r + chr(10) for r in rows)


@contextmanager
def _ledger_lock(home: Path):
    """账本互斥锁（fork9 S3-一/二 根治：fcntl.flock 内核级）。
    演进史：v0.3 O_EXCL+判龄夺锁（裁定#1）→ fork8 F3 pid 验死+rename 原子占领 →
    fork9 弃用户态协议改 flock——进程退出/崩溃由内核自动释放，陈锁判定、验死竞态
    （EPERM 被 except OSError 误判死亡→活锁被抢）、rename 迟到窗口（双持丢行）、
    空锁窗口四类问题整族消失。锁文件保留 holder 标记仅作诊断。类 Unix（Linux/macOS）。"""
    import fcntl
    lock = home / ".lock"
    deadline = time.monotonic() + 60
    fd = None
    while time.monotonic() < deadline:
        fd = os.open(str(lock), os.O_CREAT | os.O_WRONLY | os.O_NOFOLLOW, 0o600)  # fork19-CX11
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except OSError:
            os.close(fd)
            fd = None
            time.sleep(0.05)
    if fd is None:
        print("wenqu: 错误：账本锁被持有超 60s——另一进程在写或异常，退出保护（exit 2）", file=sys.stderr)
        sys.exit(2)  # die 定义在后，此处内联同语义
    try:
        os.write(fd, f"{os.getpid()},{now()}".encode())
        yield
    finally:
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
        finally:
            os.close(fd)
def die(msg, code=2):
    print(f"wenqu: 错误：{msg}", file=sys.stderr)
    sys.exit(code)


def home_of(args) -> Path:
    h = Path(getattr(args, "home", None) or (Path(args.path) / ".wenqu"))
    if h.exists() and not h.is_dir():
        die(f"--home 路径被文件占用：{h}（exit 2）")  # fork12（S6-4b）：原裸 FileExistsError traceback exit 1
    h.mkdir(parents=True, exist_ok=True)
    return h


def now() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())  # v0.2#9：统一 UTC


# ---------- 账本 ----------

def load_entries(home: Path):
    led = home / LEDGER
    if not led.exists():
        return []
    entries, bad = [], []
    # fork6（#8）：非 UTF-8 行不再裸 crash（GBK 账本等外部写入真实存在），replace 后由
    # JSON 解析层报「损坏」走 repair 自愈；fork6（#3）：合法 JSON 非对象行（[1,2]/"x"）
    # 原穿透到下游 .get() 裸 AttributeError——此处与 JSON 损坏同路报错
    for i, line in enumerate(led.read_text(encoding="utf-8", errors="replace").split("\n"), 1):
        if not line.strip():
            continue
        try:
            d = json.loads(line)
            if not isinstance(d, dict):
                bad.append(f"第{i}行非对象 JSON：{type(d).__name__}")
                continue
            if d.get("kind", "finding") == "finding" and not d.get("id"):
                bad.append(f"第{i}行 finding 缺 id")  # fork9 S3-三：原穿透 resolve e["id"] 裸 KeyError
                continue
            entries.append(d)
        except json.JSONDecodeError as e:
            bad.append(f"第{i}行 JSON 损坏：{e}")
    if bad:
        die(f"账本不可解析——{len(bad)} 处损坏（前 10：{'；'.join(bad[:10])}）——可 wenqu repair 自愈")
    return entries


def _append_unlocked(home: Path, entries) -> None:
    """锁内批写原语（裁定#4：整账本+新行→tmp→os.replace）。
    fork6（#1/#2/#6）：调用者必须已持 _ledger_lock——「锁外读-判定/锁内写」分离
    是并发 ingest 双入账/repair 陈旧快照吞行/sweep 复活已关发现三缺陷的共同根因。"""
    if isinstance(entries, dict):
        entries = [entries]  # fork8 F4b：close 传单 dict 时 for-e-in-dict 迭代出键=每键一行写坏账本（归一原只在 append 有）
    led = home / LEDGER
    # fork7（#8b，加固七）：读写 surrogateescape 配对——repair 字节保真保留的 GBK 行
    # 使原 utf-8 严格读在此裸 UnicodeDecodeError，写路径（run/ingest/close/charter）全崩
    # 且 repair 判其无病不隔离=只读写死锁闭环（fork6 修 load_entries/repair 漏本处=同族半改）
    base = led.read_text(encoding="utf-8", errors="surrogateescape") if led.exists() else ""
    if base and not base.endswith("\n"):
        base += "\n"  # fork8 F7：外部无尾换行 append 后直接拼=粘行损坏全账本
    tmp = home / (LEDGER + ".tmp")
    _ledger_data = (base + "".join(json.dumps(e, ensure_ascii=False) + chr(10) for e in entries)).encode("utf-8", "surrogateescape")
    _lfd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)  # fork19-CX11
    try:
        _written = 0  # fork19-CX14：循环写满——短写（ENOSPC/FUSE）禁 replace 防半截账本
        while _written < len(_ledger_data):
            _n = os.write(_lfd, _ledger_data[_written:])
            if _n == 0: raise OSError("short write: 0 bytes")
            _written += _n
    finally:
        os.close(_lfd)
    os.replace(tmp, led)  # 原子替换（裁定#4：整批要么全在要么全不在）


def append(home: Path, entries) -> None:
    """事务化批写（裁定#1#2#4）：单锁内整账本+新行 → tmp → os.replace。entries 接受单 dict 或列表。"""
    if isinstance(entries, dict):
        entries = [entries]
    with _ledger_lock(home):
        _append_unlocked(home, entries)


def _auto_id(station: str) -> str:
    """AUTO id=时间戳+pid+station+uuid 尾（裁定#6 真防线；fork6#11：删自增序号死代码——
    计数器 dutifully 自增但从未拼进 id，注释声称的『同进程序号』防线不存在）。"""
    import uuid
    return f"AUTO-{time.strftime('%Y%m%d%H%M%S')}-{os.getpid()}-{station}-{uuid.uuid4().hex[:4]}"


def validate_finding(d: dict, where: str) -> str:
    """返回错误串；空串=合法。必填 id/sev/status；枚举严格。"""
    if not isinstance(d, dict):
        return f"{where}：非对象"
    sev = d.get("sev", d.get("severity"))  # 纯校验无副作用（裁定#3）：归一只在 ingest 落
    sev = {"高": "HIGH", "中": "MEDIUM", "低": "LOW"}.get(str(sev).strip(), sev) if sev is not None else None
    if not isinstance(d.get("id"), str) or not d["id"].strip():
        return f"{where}：缺/非法必填键 id"
    if sev is None:
        return f"{where}：缺必填键 sev（或 severity）"
    if not d.get("status"):
        return f"{where}：缺必填键 status"
    if str(sev).upper() not in SEVS:
        return f"{where}：sev 非法（须为 {'/'.join(SEVS)}）"
    if str(d["status"]).upper() not in STATUSES:
        return f"{where}：status 非法（须为 {'/'.join(STATUSES)}）"
    return ""


def validate_transition(d: dict, where: str) -> str:
    """加固⑤：转移行 schema——必填 id/to；to 须合法状态。"""
    if not isinstance(d, dict):
        return f"{where}：转移非对象"
    for k in ("id", "to"):
        if k not in d:
            return f"{where}：转移缺必填键 {k}"
    if str(d["to"]).upper() not in STATUSES:
        return f"{where}：转移 to 非法（{d['to']}）"
    if d.get("from") and str(d["from"]).upper() == str(d["to"]).upper():
        return f"{where}：空转移（from=to）"  # 裁定#22：ingest 路径同享 cmd_close 的语义
    return ""


def resolve(entries):
    """发现+转移 → 现态视图：{id: (finding, 现status, 关闭时刻 or None)}"""
    view = {}
    for e in entries:
        if e.get("kind", "finding") == "finding":
            fid = e.get("id")
            if not fid:
                die(f"账本内发现缺 id——可 wenqu repair 自愈")
            if fid in view:
                die(f"账本内发现 id 重复：{fid}")
            view[fid] = [e, str(e["status"]).upper(), None]
    for e in entries:
        if e.get("kind") == "transition":
            fid = e.get("id")
            if fid not in view:
                die(f"转移指向不存在的发现：{fid}")
            view[fid][1] = str(e.get("to", view[fid][1])).upper()
            if view[fid][1] in ("CLOSED", "FIXED", "VERIFIED"):
                view[fid][2] = e.get("ts")
            else:
                view[fid][2] = None  # fork6#12：重开（转回非终态）清残留关闭时刻
    return view


# ---------- 命令 ----------

def cmd_init(args):
    root = Path(args.path).resolve()
    if not root.is_dir():
        die(f"路径不存在：{root}")
    exts = getattr(args, "include_exts", None) or SRC_EXTS
    skip = set(x for x in (getattr(args, "skip_dirs", "") or "").split(",") if x)
    picked = _scope_files(root, exts, skip)
    if not picked:
        die("范围内零源文件（用 --include 自定义）")
    scope_hash = _scope_hash(picked)
    home = home_of(args)
    # fork19-CX1/C3（Codex#1+K3-C2 双族交叉确认）：init 全程持锁+state 原子写——
    # 原不持锁：并发下 B 写的账本可被 A 的 write_text("") 清空；state.json 原地覆写可读到半截 JSON
    with _ledger_lock(home):
        old = home / STATE
        if old.exists():
            prev = json.loads(old.read_text(encoding="utf-8"))
            led_f = home / LEDGER
            has_ledger = led_f.exists() and led_f.stat().st_size > 0
            if prev.get("scope_hash") != scope_hash and has_ledger and not getattr(args, "force", False):
                die(f"范围已变（{prev.get('files')}→{len(picked)} 文件）而账本非空——重 init 将使旧账失去基准，确认请 --force（v0.2#11）")
        # state 原子写（K3-C2）：tmp→replace 而非原地覆写——并发 verify 不再读到半截
        st_tmp = home / (STATE + ".tmp")
        # fork19-CX11（Codex 终审#4）：O_NOFOLLOW|O_EXCL 防预置符号链接截断覆写仓外文件
        _st_data = json.dumps({
            "version": VERSION, "created_at": now(), "root": str(root),
            "scope_hash": scope_hash, "files": len(picked), "exts": list(exts), "skip_dirs": sorted(skip),
        }, ensure_ascii=False, indent=1).encode("utf-8")
        _st_fd = os.open(str(st_tmp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
        try:
            _sw = 0; _sd = _st_data if isinstance(_st_data, bytes) else _st_data.encode()
            while _sw < len(_sd):
                _n = os.write(_st_fd, _sd[_sw:])
                if _n == 0: raise OSError("short write")
                _sw += _n
        finally:
            os.close(_st_fd)
        os.replace(st_tmp, home / STATE)
        if not (home / LEDGER).exists():
            (home / LEDGER).write_text("", encoding="utf-8")  # O_CREAT 语义=仅在不存在时创建，不截断既有
    print(f"OK init：范围冻结 {len(picked)} 文件，scope_hash={scope_hash}，账本在 {home / LEDGER}")


def _scope_files(root: Path, exts, skip=()):
    skip = set(skip) | SKIP_DIRS
    picked = {}
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d not in skip]
        for fn in filenames:
            if fn.endswith(tuple(exts)):
                p = Path(dirpath) / fn
                if p.is_symlink():  # 裁定#5：防符号链接逃逸
                    continue
                try:
                    data = p.read_bytes()  # 裁定#17：读异常守卫
                except OSError:
                    continue
                picked[str(p.relative_to(root)).replace("\\", "/")] = hashlib.sha256(data).hexdigest()
    return picked


def _scope_hash(picked: dict) -> str:
    blob = "".join(f"{k}:{v}\n" for k, v in sorted(picked.items()))
    return hashlib.sha256(blob.encode()).hexdigest()[:16]


def cmd_run(args):
    home = home_of(args)
    if not (home / STATE).exists():
        die("未 init（无 state.json）——先 wenqu init")
    stations = dict(STATIONS)
    extra = home / "stations.json"
    if extra.exists():  # v0.3 血统件C：域探测器插座（问渠线配置即插，零改码）
        try:
            customs = json.loads(extra.read_text(encoding="utf-8"))
            for k, v in customs.items():
                assert isinstance(v.get("cmd"), list) and all(isinstance(x, str) for x in v["cmd"]) and v["cmd"], k
                if str(v.get("sev", "")).upper() not in SEVS:
                    die(f"stations.json 站位 {k} 的 sev 非法：{v.get('sev')!r}（须 HIGH/MEDIUM/LOW，fork9 S3-六：原缺失时 FAIL 后才在落账中途裸 KeyError=半事务）")
                stations[k] = v
        except Exception as e:
            die(f"stations.json 非法：{e}")
    if args.station not in stations:
        die(f"未知站位 {args.station}；可用：{', '.join(sorted(stations))}（AI 站走 charter+ingest）")
    if not Path(args.path).resolve().is_dir():
        die(f"--path 不存在：{args.path}（fork6#10：原误归因为『依赖命令不可用』误导排障）")

    st = stations[args.station]
    runs = home / "runs"
    runs.mkdir(exist_ok=True)
    logf = runs / f"{time.strftime('%Y%m%d-%H%M%S')}-{int(time.time()*1000)%1000:03d}-{args.station}.log"  # 裁定#8：毫秒防同秒覆盖
    # fork2（2026-10-02 加固）：超时防线——stations.json 可 per-station 配 timeout（秒，默认 300）；
    # 超时=环境错误 exit 2 不落账不计通过（轨道铁律 2「超时不得记零发现」的 CLI 侧落地）
    # fork3（2026-10-02 加固二）：timeout 值域校验——非数字/零/负数为配置错误 die exit 2
    # （原实现非数字裸 traceback、负值被当立即超时且文案误导）
    timeout_raw = st.get("timeout", 300)
    try:
        timeout_s = int(timeout_raw)
    except (TypeError, ValueError):
        die(f"站位 {args.station} 的 timeout 非法：{timeout_raw!r}（须为 ≥1 整数秒，exit 2 不落账）")
    if timeout_s < 1:
        die(f"站位 {args.station} 的 timeout 非法：{timeout_s}（须 ≥1 秒，exit 2 不落账）")
    try:
        r = subprocess.run(st["cmd"], cwd=str(Path(args.path).resolve()),
                           capture_output=True, text=True, encoding="utf-8", errors="replace",
                           timeout=timeout_s)
    except FileNotFoundError:
        die(f"站位 {args.station} 依赖命令不可用：{st['cmd'][0]}（exit 2，不落账）")
    except subprocess.TimeoutExpired:
        die(f"站位 {args.station} 超时（>{timeout_s}s，exit 2 不落账不计通过）")
    except OSError as _ose:
        # fork19-CX3（Codex#3）：PermissionError/ENOEXEC/EISDIR 等 OSError 族——
        # 原仅捕 FileNotFoundError，其余裸 traceback exit 1 冒充命中
        die(f"站位 {args.station} 探测器无法执行：{st['cmd'][0]}（{_ose.__class__.__name__}，exit 2 不落账）")
    run_row = {"kind": "run", "station": args.station, "exit": r.returncode, "ts": now(), "root": str(Path(args.path).resolve())}  # fork19-CX8：run 记录仓根  # v0.3 血统件B：run 审计
    if getattr(args, "round", 0):
        run_row["round"] = args.round  # fork2：run 轮次标记——使 AUTO 发现参与 verify --convergence 判定
    # fork19-CX2（Codex#2+K3-C1 双族交叉确认）：run+finding 一次锁事务原子提交——
    # 原两次独立 append：中间窗口 verify 只见 run exit=1 无 finding → exit 0 假绿；进程崩溃=永久假绿
    # fork19-CX3（Codex#3）：rc 分类收紧——负数（信号终止如 SIGTERM=-15）也归环境错误不落账
    if r.returncode != 0 and r.returncode != 1:
        # rc≥2 或负数=环境错误
        try:
            logf.write_text(r.stdout + r.stderr, encoding="utf-8")
            _logref = f"日志 {logf}"
        except OSError:
            print(f"wenqu: 警告：日志写入失败 {logf}——证据转 stderr", file=sys.stderr)
            print(r.stdout + r.stderr, file=sys.stderr)
            _logref = "日志缺失（写入失败，证据已转 stderr）"
        die(f"站位 {args.station} 探测器自身错误（exit={r.returncode}，{_logref}——不落账不计通过）", 2)
    # 原子批写：run + finding 同一把锁内一次 _append_unlocked
    _batch = [run_row]
    if r.returncode != 0:
        finding_row = {"kind": "finding", "id": _auto_id(args.station),
                       "sev": st["sev"], "status": "OPEN", "title": f"站位 {args.station} FAIL（exit={r.returncode}）",
                       "provenance": {"station": args.station, "log": str(logf), "ts": now(),
                                      "root": str(Path(args.path).resolve())}}  # fork19-CX8：provenance 绑仓根（sweep 跨仓防线）
        if getattr(args, "round", 0):
            finding_row["round"] = args.round
        _batch.append(finding_row)
    with _ledger_lock(home):
        _append_unlocked(home, _batch)
    _logref = f"日志 {logf}"
    _log_written = True
    try:
        logf.write_text(r.stdout + r.stderr, encoding="utf-8")
    except OSError as log_err:
        print(f"wenqu: 警告：日志写入失败 {logf}（{log_err}）——落账不受影响", file=sys.stderr)
        _logref = "日志缺失（写入失败）"  # fork14（S8-F5）：原 FAIL 行仍宣称日志路径=自相矛盾+审计断链 404
        _log_written = False
    if not _log_written:
        # fork15（S9-F3）：账本层断链回填——provenance.log 指向未写成文件=审计 404（stdout 早已消散）
        append(home, {"kind": "note", "id": "LOG-MISSING", "station": args.station,
                      "detail": f"日志写入失败，provenance.log 路径无效：{logf}", "ts": now()})
    if r.returncode != 0:
        print(f"FAIL {args.station}（exit={r.returncode}）——已落账 OPEN，{_logref}")
        sys.exit(1)
    print(f"OK {args.station} PASS，{_logref}")
    sys.exit(0)


def cmd_ingest(args):
    home = home_of(args)
    src = Path(args.file)
    if not src.is_file():
        die(f"文件不存在：{src}")
    existing = {e["id"] for e in load_entries(home) if e.get("kind", "finding") == "finding"}
    # 加固⑥：两遍式原子 ingest——先全量解析校验（含转移指向存在性），零错才落账；
    # 默认全有或全无（审计管线不吞半批），--partial 恢复逐行部分接收旧行为
    staged, errs = [], []
    try:
        src_text = src.read_text(encoding="utf-8")
    except UnicodeDecodeError as e:
        die(f"源文件非 UTF-8：{e}（请转码后重投；exit 2）", 2)  # fork8 F9：原裸 traceback exit 1
    for i, line in enumerate(src_text.split("\n"), 1):
        if not line.strip():
            continue
        try:
            d = json.loads(line)
        except json.JSONDecodeError as e:
            errs.append(f"第{i}行 JSON 损坏：{e}")
            continue
        d.setdefault("kind", "finding")
        if d.get("kind") not in ("finding", "transition"):
            # fork8 F5：原实现 kind:"run"/"charter" 行掉进 finding 分支照单全收——一条命令
            # 即可伪造 PASS run 行骗 sweep 误关真实发现；审计行只能由 CLI 自身产生
            errs.append(f"第{i}行：kind 非法 {d.get('kind')}（审计行 run/charter/note 只能由 CLI 产生，外部仅 finding/transition）")
            continue
        if "round" in d:
            r = d["round"]
            if not isinstance(r, int) or isinstance(r, bool) or r < 1:
                errs.append(f"第{i}行：行内 round 非法 {r!r}（轮次由 --round 指定，须 ≥1 整数）")
                continue
            d.pop("round")  # fork8 F5：行内 round 剥离——轮次统一由 --round 指定，防手写伪造轮次铸收敛
        if d.get("kind") == "transition":
            terr = validate_transition(d, f"第{i}行")
            if terr:
                errs.append(terr)
                continue
            d["to"] = str(d["to"]).upper()
            d.setdefault("ts", now())
            staged.append(d)
            continue
        err = validate_finding(d, f"第{i}行")
        if err:
            errs.append(err)
            continue
        if d["id"] in existing:
            errs.append(f"第{i}行：id 重复 {d['id']}")
            continue
        if "sev" not in d and "severity" in d:
            d["sev"] = d["severity"]
        d["sev"] = _SEV_MAP.get(str(d["sev"]).strip(), str(d["sev"]))
        d["sev"], d["status"] = str(d["sev"]).upper(), str(d["status"]).upper()
        d.setdefault("ts", now())
        if getattr(args, "round", 0):
            d["round"] = args.round
        staged.append(d)
        existing.add(d["id"])
    known = existing | {d["id"] for d in staged if d.get("kind", "finding") == "finding"}
    staged_final = []
    for d in staged:
        if d.get("kind") == "transition" and d["id"] not in known:
            errs.append(f"孤儿转移：id {d['id']} 在本批与账本中均无对应发现（拒绝，防砖死账本）")
            continue
        staged_final.append(d)
    if errs and not args.partial:
        print(f"OK ingest：原子拒绝——0 条入账，{len(errs)} 处问题（--partial 可恢复逐行模式）", file=sys.stderr)
        for e in errs[:8]:
            print(f"  拒绝：{e}", file=sys.stderr)
        sys.exit(2)
    # fork6（#1/#5，2026-10-02 加固六）：写入段全程持锁+锁内重验——
    # 原实现查重在锁外读、append 持锁写，「读-判-写」非原子：并发 ingest 同 id 双双
    # 通过初筛入账→账本重复 id→resolve die 砖死（25 轮实测 76% 命中）。
    # 同段补状态机校验：外部 transition 与 close 同权受 ALLOWED_TRANSITIONS 约束
    # （原 ingest 路径可 CLOSED→FIXED 横跳+伪造 from），--allow-any 与 close 同名逃生门。
    late_errs = []
    with _ledger_lock(home):
        cur = load_entries(home)
        cur_ids = {e["id"] for e in cur if e.get("kind", "finding") == "finding"}
        # fork8 F2：折叠视图——原 cur_view 只含账本既有发现，同批 finding 现态被假定为 OPEN
        # （同批 CLOSED+转移=状态机旁路；VERIFIED→OPEN 合法重开误拒；行序敏感误报孤儿；
        # 多步链 from 失实误拒——四症状同根）。每接受一行即折叠，转移对折叠后现态校验。
        fold = {fid: st for fid, (_, st, _) in (resolve(cur) if cur else {}).items()}
        # fork8 F2：本批 findings 预折叠（行序无关——转移可引用同批稍后定义的 finding）
        for d in staged_final:
            if d.get("kind") == "finding":
                fold[d["id"]] = str(d["status"]).upper()
        fold_ids = set(cur_ids)
        known = fold_ids | {d["id"] for d in staged_final if d.get("kind", "finding") == "finding"}
        final = []
        for d in staged_final:
            if d.get("kind") == "finding":
                if d["id"] in fold_ids:
                    late_errs.append(f"id 重复（并发写入冲突）{d['id']}")
                    continue
                fold_ids.add(d["id"])
                fold[d["id"]] = str(d["status"]).upper()
                final.append(d)
                continue
            st_now = fold.get(d["id"])
            if d["id"] not in known:
                late_errs.append(f"孤儿转移：id {d['id']} 在本批与账本中均无对应发现")
                continue
            frm = str(d.get("from") or st_now or "OPEN").upper()
            if not getattr(args, "allow_any", False):
                if frm != st_now:
                    late_errs.append(f"转移 from 失实 {d['id']}：声明 {frm}，现态 {st_now}")
                    continue
                if str(d["to"]).upper() not in ALLOWED_TRANSITIONS.get(st_now, set()):
                    late_errs.append(f"状态机拒绝 {d['id']}：{st_now}→{d['to']} 不在允许集")
                    continue
            fold[d["id"]] = str(d["to"]).upper()
            if getattr(args, "round", 0):
                d["round"] = args.round  # fork8 F5④：--round 对转移行同样生效（原静默 no-op）
            final.append(d)
        if final and (not late_errs or args.partial):
            _append_unlocked(home, final)
        elif final and late_errs and not args.partial:
            pass  # 原子模式：任一锁内冲突→整批不写（先验后写，不吞半批）
    if late_errs:
        errs.extend(late_errs)
        print(f"OK ingest：锁内重验拦截 {len(late_errs)} 条" + ("（--partial 已跳过冲突行）" if args.partial else "——整批拒绝"), file=sys.stderr)
        for e in late_errs[:8]:
            print(f"  拒绝：{e}", file=sys.stderr)
        if not args.partial:
            sys.exit(2)
    ok = len(final)
    print(f"OK ingest：入账 {ok} 条" + (f"；拒绝 {len(errs)} 条" if errs else ""))
    for e in errs[:8]:
        print(f"  拒绝：{e}", file=sys.stderr)
    sys.exit(2 if errs else 0)


