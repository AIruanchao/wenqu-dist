{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "wenqu:schemas/run-event-v2.json",
  "title": "Run/Station Event Schema v2",
  "description": "统一结果双轴：execution_status × policy_verdict——Codex 方案 §6.1 契约冻结。P0-4 加固：停等元数据/审批消费/action saga 观察事件与 seal 封印字段全部正式声明（自产事件全过本 schema）；ERROR+PASS 禁止、PASS 带 findings 禁止",
  "type": "object",
  "required": ["schema_version", "event_type", "run_id", "execution_status", "policy_verdict", "identity"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "event_type": {
      "enum": [
        "RUN_CREATED", "STAGE_STARTED", "STAGE_COMPLETED", "RUN_COMPLETED",
        "WAITING_RAISED", "WAITING_RESUMED", "SUPERSEDED",
        "APPROVAL_CONSUMED", "FINDING_REGISTERED",
        "ACTION_AUTH_RESERVED", "ACTION_STARTED", "ACTION_COMMITTED",
        "ACTION_FAILED_UNKNOWN"
      ]
    },
    "run_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64},
    "task_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 64},
    "stage": {"enum": ["S1_REQUIREMENT", "S2_SOLUTION", "S3_EQS_PRE", "S4_IMPLEMENT", "S5_CONVERGENCE", "S6_EQS_FULL", "S7_GATE"]},
    "station_id": {"type": "integer", "minimum": 0, "maximum": 7},
    "attempt_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"},
    "execution_status": {
      "enum": ["COMPLETED", "ERROR", "BLOCKED", "TIMEOUT", "CANCELLED"],
      "description": "工具/命令实际执行结果——不可由调用者自报"
    },
    "policy_verdict": {
      "enum": ["PASS", "FAIL", "CONDITIONAL", "NOT_APPLICABLE", "NOT_EVALUATED"],
      "description": "策略判定——由 gate aggregator 基于 evidence 计算"
    },
    "identity": {
      "type": "object",
      "required": ["commit_sha", "environment", "scope_hash"],
      "properties": {
        "repo_id": {"type": "string"},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "environment": {"enum": ["local", "staging", "production"]},
        "scope_hash": {"type": "string"},
        "policy_hash": {"type": "string", "minLength": 1},
        "ruleset_hash": {"type": "string"},
        "data_config_hash": {"type": "string"},
        "lockfile_hash": {"type": "string"}
      }
    },
    "findings": {
      "type": "array",
      "items": {"type": "string", "pattern": "^fnd_[a-zA-Z0-9_]+$"}
    },
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "state_version": {"type": "integer", "minimum": 1},
    "ts": {"type": "string", "format": "date-time"},
    "actor": {"type": "string"},
    "seal": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "P0-4：内部控制事件封印 hex(hmac_sha256(seal_secret, canonical(payload_without_seal)))——RunManager._emit 注入，重放逐条验封；公共 EventStore.append 对控制事件类型一律拒绝"
    },
    "stop_type": {
      "enum": ["ambiguity", "prod-write", "ddl", "release", "scope", "fund-auth", "exm-fuse", "resource", "ext-unavail"]
    },
    "stop_reason": {"type": "string"},
    "stop_event_id": {"type": "string", "minLength": 1},
    "required_preconditions": {"type": "array", "items": {"type": "string"}},
    "preconditions_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval_id": {"type": "string", "pattern": "^apr_[a-zA-Z0-9_]+$"},
    "approval_type": {
      "enum": ["resume", "risk", "merge", "release", "ddl", "prod_write", "fund_auth", "rollback"]
    },
    "nonce_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "R7-AUTH-DUAL-CONSUME-005：APPROVAL_CONSUMED 对账面——canonical payload 的 sha256；重放侧强校验存在与形状（缺失即 Corruption）"
    },
    "cosign_digests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key_id", "actor", "signature_digest"],
        "properties": {
          "key_id": {"type": "string", "pattern": "^key_[a-zA-Z0-9_-]+$"},
          "actor": {"type": "string", "minLength": 1},
          "signature_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      },
      "description": "R7-AUTH-DUAL-CONSUME-005：APPROVAL_CONSUMED 联签摘要列表（key 归属+actor+签名 sha256 指纹；无联签=空数组）；高危类型必须 ≥2 名不同 key（重放侧强校验）"
    },
    "expires_at": {"type": "string", "format": "date-time"},
    "finding_fingerprints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "finding_id": {"type": "string", "pattern": "^fnd_[a-zA-Z0-9_]+$"},
    "fingerprint": {"type": "string", "minLength": 1},
    "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]},
    "priority": {"enum": ["P0", "P1", "P2", "P3"]},
    "finding_detail": {"type": "string"},
    "action_id": {"type": "string", "pattern": "^act_[a-zA-Z0-9_-]+$"},
    "action_type": {"type": "string", "minLength": 1},
    "action_target": {"type": "string"},
    "action_detail": {"type": "string"},
    "receipt": {"type": "string"},
    "terminal_reason": {"type": "string"},
    "supersede_reason": {"type": "string"},
    "prev_event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"execution_status": {"enum": ["ERROR", "BLOCKED", "TIMEOUT", "CANCELLED"]}}, "required": ["execution_status"]},
      "then": {
        "properties": {
          "policy_verdict": {"enum": ["FAIL", "NOT_EVALUATED"]}
        }
      }
    },
    {
      "if": {"properties": {"policy_verdict": {"const": "PASS"}}, "required": ["policy_verdict"]},
      "then": {
        "properties": {
          "execution_status": {"const": "COMPLETED"},
          "findings": {"maxItems": 0}
        },
        "required": ["execution_status"]
      }
    }
  ],
  "$comment": "UNKNOWN/MISSING/STALE/MALFORMED/EMPTY/TIMEOUT 均是阻断态，不得折算为 PASS（不变量 #1）；P0-4 双轴根修：execution 非 COMPLETED 不得产出任何完成态（含 CONDITIONAL）——RUN_COMPLETED 层由重放强制，attempt 层由 outcome 映射强制；观察类事件（APPROVAL_CONSUMED/FINDING_REGISTERED/ACTION_*）不递增 state_version，须锚定当前版本。F4-SCHEMA-001 #5（2026-10-08 Codex 第四轮根修）：schema 层机器可判——execution_status ∈ {ERROR,BLOCKED,TIMEOUT,CANCELLED} 时 policy_verdict 只允许 FAIL/NOT_EVALUATED，TIMEOUT+CONDITIONAL / TIMEOUT+PASS 等双轴洗白在 schema 层直接拒绝（此前仅由状态机代码强制，schema 无此约束）；station-result-v2.schema.json 与 gate_aggregator.mirror_validate_station_result_v2 已同步同款规则"
}
