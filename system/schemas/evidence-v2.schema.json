{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "wenqu:schemas/evidence-v2.json",
  "title": "Trusted Evidence Schema v2",
  "description": "不可伪造证据绑定——Codex 方案 §6.6 契约。P0-4 加固：schema_version/verdict/artifact 全部必填，artifact 非空（sha256+size）",
  "type": "object",
  "required": ["schema_version", "evidence_id", "run_id", "identity", "tool", "runner", "execution", "verdict", "artifact", "fresh_until"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "evidence_id": {"type": "string", "pattern": "^ev_[a-zA-Z0-9_]+$"},
    "run_id": {"type": "string"},
    "task_id": {"type": "string"},
    "stage": {"type": "string"},
    "station_id": {"type": "integer", "minimum": 0, "maximum": 7},
    "attempt_id": {"type": "string"},
    "identity": {
      "type": "object",
      "required": ["commit_sha", "environment", "scope_hash"],
      "properties": {
        "repo_id": {"type": "string"},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "base_sha": {"type": "string"},
        "environment": {"type": "string"},
        "scope_hash": {"type": "string"},
        "ruleset_hash": {"type": "string"},
        "data_config_hash": {"type": "string"},
        "lockfile_hash": {"type": "string"}
      }
    },
    "runner": {
      "type": "object",
      "required": ["runner_id", "version"],
      "properties": {
        "runner_id": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "digest": {"type": "string"}
      }
    },
    "execution": {
      "type": "object",
      "required": ["argv_digest", "started_at", "finished_at", "actual_exit_code"],
      "properties": {
        "argv_digest": {"type": "string"},
        "cwd_digest": {"type": "string"},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "actual_exit_code": {"type": "integer"},
        "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "artifact": {
      "type": "object",
      "required": ["artifact_sha256", "artifact_size"],
      "properties": {
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifact_size": {"type": "integer", "minimum": 1}
      }
    },
    "verdict": {
      "enum": ["PASS", "FAIL", "CONDITIONAL", "NOT_APPLICABLE", "NOT_EVALUATED"]
    },
    "fresh_until": {
      "type": "string",
      "format": "date-time",
      "description": "由受保护 policy 按 trusted_finished_at + policy_ttl 计算——调用者和工件不得自行声明"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "PASS"}}, "required": ["verdict"]},
      "then": {
        "properties": {
          "execution": {
            "type": "object",
            "required": ["actual_exit_code"],
            "properties": {
              "actual_exit_code": {"const": 0}
            }
          }
        }
      }
    }
  ],
  "$comment": "evidence 不得是 symlink、外部路径、空文件或无哈希文件（不变量 #11）；P0-4：verdict 与 artifact（sha256+size）必填——无工件/无判定的证据不具可信形态。F4-SCHEMA-001 #1（2026-10-08 Codex 第四轮根修）：PASS 裁决 + execution.actual_exit_code 非 0 → 拒——退出码非零（真实执行失败/超时/被杀）的证据不得声称 PASS（铁律 2 纵深：站内构造器拦截之外，schema 层机器可判）"
}
