{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "wenqu:schemas/station-result-v2.json",
  "title": "Bug 八站 Station Result Schema v2",
  "description": "每站统一结果——Codex 方案 §7.2 契约。P0-4 加固：PASS 必须带 coverage（分母>0）与非空 artifacts，且 execution rc=0 + assertion PASS；rc 非 0 不得 PASS。F4-SCHEMA-001 加固：PASS 必须 execution COMPLETED 且 coverage.scanned == denominator（分母缩水即拒）；执行非完成态只允许 FAIL/NOT_EVALUATED/NOT_APPLICABLE 裁决（TIMEOUT+PASS/TIMEOUT+CONDITIONAL 双轴洗白全拒；NOT_APPLICABLE 是站级探针缺失/不适用语义，聚合层落 CONDITIONAL 不上绿）",
  "type": "object",
  "required": ["schema_version", "run_id", "station_id", "attempt_id", "execution_status", "policy_verdict", "identity", "tool", "execution"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "run_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"},
    "station_id": {"type": "integer", "minimum": 0, "maximum": 7},
    "attempt_id": {"type": "string"},
    "execution_status": {"enum": ["COMPLETED", "ERROR", "BLOCKED", "TIMEOUT", "CANCELLED"]},
    "policy_verdict": {"enum": ["PASS", "FAIL", "CONDITIONAL", "NOT_APPLICABLE", "NOT_EVALUATED"]},
    "identity": {
      "type": "object",
      "required": ["commit_sha", "environment", "scope_hash"],
      "properties": {
        "project_id": {"type": "string"},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "environment": {"type": "string"},
        "scope_hash": {"type": "string"},
        "ruleset_hash": {"type": "string"},
        "data_config_hash": {"type": "string"},
        "lockfile_hash": {"type": "string"}
      }
    },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "digest": {"type": "string"}
      }
    },
    "execution": {
      "type": "object",
      "required": ["argv_digest", "started_at", "ended_at", "actual_exit_code", "expected_exit_set", "assertion_verdict"],
      "properties": {
        "argv_digest": {"type": "string"},
        "cwd_digest": {"type": "string"},
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "timeout_s": {"type": "integer", "minimum": 1},
        "actual_exit_code": {
          "type": "integer",
          "description": "trusted runner 实际 waitpid 捕获——不可由调用者填写"
        },
        "expected_exit_set": {
          "type": "array",
          "items": {"type": "integer"},
          "description": "该测试允许的内层退出码集合（负例可有非零）"
        },
        "assertion_verdict": {
          "enum": ["PASS", "FAIL", "ERROR"],
          "description": "测试 harness 对行为是否符合预期的判断"
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": ["denominator", "scanned"],
      "properties": {
        "denominator": {"type": "integer", "minimum": 0},
        "scanned": {"type": "integer", "minimum": 0},
        "exclusions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "finding_ids": {"type": "array", "items": {"type": "string"}},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cas_digest", "size"],
        "properties": {
          "cas_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 1}
        }
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"execution_status": {"enum": ["ERROR", "BLOCKED", "TIMEOUT", "CANCELLED"]}}, "required": ["execution_status"]},
      "then": {
        "properties": {
          "policy_verdict": {"enum": ["FAIL", "NOT_EVALUATED", "NOT_APPLICABLE"]}
        }
      }
    },
    {
      "if": {"properties": {"policy_verdict": {"const": "PASS"}}, "required": ["policy_verdict"]},
      "then": {
        "required": ["coverage", "artifacts"],
        "properties": {
          "execution_status": {"const": "COMPLETED"},
          "coverage": {
            "type": "object",
            "required": ["denominator", "scanned"],
            "properties": {
              "denominator": {"type": "integer", "minimum": 1},
              "scanned": {"type": "integer", "minimum": 1}
            },
            "allOf": [
              {"if": {"properties": {"scanned": {"const": 1}}, "required": ["scanned"]}, "then": {"properties": {"denominator": {"const": 1}}, "required": ["denominator"]}},
