# wenqu v3.0 配置 —— 复制为 ~/.wenqu/env（全局）或项目 .wenqu.env（项目级）
# 全部留空/占位符 = 对应组件自动禁用（doctor 会标灰）

# ── 仓库（verify/gate/preflight 必需）──
export WENQU_REPO="OWNER/REPO"              # GitHub owner/repo
export WENQU_REPO_DIR="$HOME/my-project"    # 本地仓库路径

# ── 中转推送（多机协作时用，单机可删）──
export WENQU_RELAY_HOST=""                  # 开发机 user@host（空=禁用 relay-push）
export WENQU_RELAY_LOCAL="$HOME/my-project-relay"

# ── 数据库（守恒哨兵/守护进程/DB 组件）──
export WENQU_DB_SSH=""                      # DB 主机 ssh 别名（空=本地 psql）
export WENQU_DB_NAME="mydb"
export WENQU_DB_DSN=""                      # psycopg2 DSN，空=Unix socket + WENQU_DB_NAME

# ── 告警（哨兵外发；空=只写本地日志）──
export WENQU_ALERT_WEBHOOK=""               # 飞书/Slack/企业微信 webhook

# ── 巡检目标 ──
export WENQU_CERT_DOMAIN=""                 # 证书哨兵域名（空=禁用）
export WENQU_DEPLOY_DIR="/opt/myapp"        # 部署目录
export WENQU_LINEAGE_GIT="/opt/lineage/repo.git"  # 血统镜像 bare 仓
